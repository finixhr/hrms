# Normalize all text files to LF in the repo AND working copy — required:
# the CI gate and several scripts/*.sh are bash scripts that break on CRLF.
* text=auto eol=lf
# binary assets — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
# the SQLite databases are gitignored anyway, but be explicit
*.db binary