# ============ Finix HR — environment template ============
# Copy to .env and fill in the values for YOUR deployment. NEVER commit .env.

# --- Database (PostgreSQL — migrated from SQLite 2026-09-30, see docs/postgresql-migration-report.md) ---
# Dev default (created by scripts/setup-and-seed.sh). For production use a
# dedicated role + database, e.g.:
#   DATABASE_URL="postgresql://hrm_user:CHANGE_ME@127.0.0.1:5432/hrm_production"
# PostgreSQL must listen on 127.0.0.1 (or a private NIC) — never expose it publicly.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/hrm_dev"

# --- Unit-test database (bun test tests/unit) — isolated, disposable, NEVER production ---
# The test preload (tests/preload.ts) refuses URLs containing "production" and
# URLs that point at a development DATABASE_URL. You normally do NOT need to
# set this: with a working DATABASE_URL in .env, the tests reuse ITS
# credentials against a separate "hrm_test" database and create that database
# automatically. Note that `bun test` auto-loads .env.test (NODE_ENV=test), so
# the value below is only a fallback candidate — set TEST_DATABASE_URL in .env
# (or as an environment variable) to override it explicitly.
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/hrm_test"

# --- H-8: MFA + camera encryption key (REQUIRED before enrolling any TOTP user) ---
# Generate with: openssl rand -hex 32
# CRIT-1 / SEC-C2: NEVER ship a real value here. The server refuses to boot
# if HRM_MFA_KEY matches any of the known-leaked values (see instrumentation.ts).
# Existing MFA enrollements encrypted under a legacy key still verify and are
# transparently re-encrypted under this key on the next successful login
# (totp.ts needsReencrypt), so rotating in production is non-disruptive.
#
# Wave 10 (2026-10-24): this key now ALSO derives the dedicated data-encryption
# keys for the payment-gateway credentials (context "saas-payments::v1") and
# the cloud-storage credentials (context "saas-storage::v1") — a breach of one
# context exposes neither of the others (see crypto-field.ts HKDF). The Owner
# Console refuses to save gateway/storage credentials when the key is unset.
# NO SECRETS FOR THOSE INTEGRATIONS LIVE IN THIS FILE — they are stored
# encrypted in the database through the console:
#   Owner Console → Settings → Payments   (SSLCommerz / bKash / Nagad / PayStation / EPS)
#   Owner Console → Settings → Storage    (Cloudflare R2 / Cloudinary + live test)
#   Owner Console → Settings → Gateway    (SMTP + SMS provider select, SSLWireless v3,
#                                          test OTP + delivery-journal strip)
HRM_MFA_KEY="GENERATE_WITH_openssl_rand_hex_32"

# --- H-2: device gateway security ---
# C-03 (updated 2026-09-22): keyless pre-registered devices are governed by the
# per-vendor admin setting "Allow Keyless Devices" (Settings → Devices in the
# HRM app). The former 7-day grace window (HRM_DEVICE_GRACE_PERIOD_DAYS) and
# the lab-only ATTENDANCE_GATEWAY_ALLOW_OPEN override were REMOVED — leaving
# either set in .env refuses boot with a migration hint. Keyless devices are
# rejected with 401 Unauthorized until the admin enables the setting or
# enrolls a comm key (Attendance → Devices → Set Comm Key). Devices with a
# comm key always authenticate normally, regardless of the setting.
# Per-SN rate limit — max requests/minute per device serial.
HRM_DEVICE_SN_RATE_LIMIT_PER_MIN="60"
# L-14: debug capture for firmware debugging. DEFAULT OFF — device comm-log
# diagnostics store REDACTED raw lines (employee names masked). Setting this
# to "true" stores UNREDACTED raw lines, enables raw-body console capture on
# /iclock/cdata, and prints a loud boot warning. Lab only: NEVER production.
ZKTECO_ADMS_DEBUG_CAPTURE="false"
ZKTECO_ADMS_ENABLED="true"
ADMS_RATE_LIMIT_PER_MIN="300"
# Automatic attendance pull: the server queues an ADMS "CHECK" command for every
# connected device on this cadence (seconds), so punches land in the attendance
# table without any manual action — even when the device does not push realtime.
# A device consumes the command on its next poll (~LOGDELAY seconds). 0 disables.
ADMS_AUTO_CHECK_SECONDS="120"
# How often (seconds) a connected device polls the server for commands; lower
# values make auto-pulled punches appear faster (more device traffic).
ADMS_LOGDELAY_SECONDS="60"
# Sweeper tick interval (ms). Default 15000 (15s).
ADMS_SWEEP_INTERVAL_MS="15000"
# Maximum retry attempts for failed AttendanceRawEvent processing before dead-letter.
ATTENDANCE_EVENT_RETRY_LIMIT="5"
# Device offline threshold (seconds) — devices not seen for this long are flagged OFFLINE.
ATTENDANCE_DEVICE_OFFLINE_THRESHOLD_SECONDS="300"
ATTENDANCE_DEVICE_WARNING_THRESHOLD_SECONDS="120"
# Punch photo storage (opt-in). When "true", photos are encrypted at rest with AES-256-GCM
# using a context derived from HRM_MFA_KEY. Photos are auto-purged after ADMS_PHOTO_RETENTION_DAYS.
ADMS_PHOTO_FUN="false"
ADMS_PHOTO_RETENTION_DAYS="30"
# Timezone offset (hours) for attendance event attribution. Default 6 (Asia/Dhaka).
ADMS_TIMEZONE_OFFSET_HOURS="6"
ADMS_TRANS_INTERVAL_MIN="1"
ADMS_TIMEOUT_MIN="30"
# Detailed health probe (queue counts, sweeper status). Off by default.
ZKTECO_ADMS_HEALTH_DETAILED="false"
# Dev simulator — strictly NODE_ENV != "production" gated.
ZKTECO_SIMULATOR_ENABLED="true"

# --- C-4: CSRF origin allowlist (comma-separated, optional) ---
# Same-host origins are always allowed; add extra embedded-preview origins here.
HRM_ALLOWED_ORIGINS=""

# --- WebAuthn / passkey MFA (optional; derived from the request when unset) ---
# HRM_WEBAUTHN_RPID is the registrable domain passkeys are bound to (NO port,
# NO scheme) — defaults to the request hostname with the port stripped. Set it
# when the app is reached through several hostnames or a proxy rewrites Host.
# HRM_WEBAUTHN_ORIGINS is the comma-separated list of origins the WebAuthn
# ceremonies may run on (scheme + host + port, e.g. apex + www) — defaults to
# the single request origin. Mismatches fail with a clear 400 at
# auth.passkey.register.finish / auth.passkey.login.finish.
HRM_WEBAUTHN_RPID=""
HRM_WEBAUTHN_ORIGINS=""

# --- LAN access from other PCs (dev server) ---
# Next 16 blocks the dev HMR websocket for origins it does not trust, which
# freezes the app on "Loading Finix HR…" when a colleague
# opens http://<this-PC's-LAN-IP>:3000 from another machine. The server's own
# network-interface IPs are allowed AUTOMATICALLY (see next.config.ts), so
# plain IP access needs no entry here. Only add extra hostnames/origins you
# also use to reach the dev server, e.g.:
#   HRM_ALLOWED_DEV_ORIGINS="hrm.local:3000,192.168.0.50"
HRM_ALLOWED_DEV_ORIGINS=""

# --- Low-7: trust the X-Forwarded-For header only behind your own proxy ---
HRM_TRUST_PROXY="0"

# --- M-12: Prisma log level (query,info,warn,error — comma separated) ---
# Production defaults to errors only.
HRM_PRISMA_LOG=""

# --- Observability kill-switches (instrumentation.ts) ---
HRM_JOBS_ENABLED="true"
# HRM_JOBS_TICK_MS overrides the background-job tick interval (default 60000ms, clamped 15s-5min).
# HRM_JOBS_TICK_MS="60000"

# --- Internal token (ADMS health POST sweep trigger, restore drill, ops) ---
# Generate with: openssl rand -hex 32
HRM_INTERNAL_TOKEN="GENERATE_WITH_openssl_rand_hex_32"

# --- Backup encryption (scripts/backup.sh) ---
# CRIT-1 / OPS-7-12: AES-256-CBC + PBKDF2 with 600000 iterations (OWASP 2023).
# Generate with: openssl rand -hex 32
HRM_BACKUP_KEY="GENERATE_WITH_openssl_rand_hex_32"
# Offsite sync command — {file} is substituted with the encrypted backup path.
# Example: BACKUP_OFFSITE_CMD="rclone copy {file} my-remote:hrm-backups/"
BACKUP_OFFSITE_CMD=""
# Alert email — overrides vendor SMTP from-address when set.
HRM_BACKUP_ALERT_EMAIL=""

# ============ SEEDING — two profiles ============
# 1) TEST seed   — HUGE dummy data:   bun run seed       (uses .env)
#                                    bun run seed:test   (loads .env.test)
# 2) PRODUCTION  — clean tenant,      bun run seed:prod  (loads .env.production)
#    seed          NO dummy data:     bun run seed:owner (uses .env)
#
# .env.test and .env.production are SELF-CONTAINED profiles (Bun's --env-file
# replaces .env entirely). Copy the one you want over .env for plain `bun run seed`.

# --- TEST seed volume knobs (src/hrm-server/seed.ts) ---
# Extra bulk dummy employees beyond the 24 curated demo staff (0 = curated-only).
SEED_TEST_BULK_EMPLOYEES="800"
# Days of attendance history per active employee (min 62).
SEED_TEST_ATTENDANCE_DAYS="180"
# Extra full-workforce PAID historical payroll runs (before the engine run).
SEED_TEST_PAYROLL_HISTORY_MONTHS="3"
# ESS login accounts created among the bulk employees (load testing).
SEED_TEST_BULK_USERS="25"
# Deterministic PRNG seed — same value => identical corpus on re-runs.
SEED_TEST_RANDOM_SEED="42"
# Hard seed timeout in ms when bulk data is enabled (default 15 min).
#SEED_TEST_TIMEOUT_MS="900000"

# --- Seed password ---
# HIGH-1: REQUIRED at seed time. The seed scripts refuse to run if this is the
# default value "Pass@123" or empty in production. Override for every deployment.
HRM_SEED_PASSWORD="CHANGE_ME_BEFORE_SEED"
# --- Clean / production seed (`bun run seed:prod` / `seed:owner`) ---
# Creates ONE vendor + ONE owner account with ALL permissions and all 14
# approval workflows — NO dummy data. Wipes the DB by default; set
# HRM_SEED_KEEP_DATA=1 for an idempotent add-only re-run.
HRM_SEED_VENDOR_NAME="Finix HR"
HRM_SEED_VENDOR_CODE="FINIX"
# Optional vendor details (leave empty to skip):
HRM_SEED_VENDOR_LEGAL_NAME=""
HRM_SEED_VENDOR_ADDRESS=""
HRM_SEED_VENDOR_PHONE=""
HRM_SEED_VENDOR_EMAIL=""
# Owner account (falls back to HRM_SEED_PASSWORD when unset):
HRM_SEED_OWNER_EMAIL="owner@finixhr.example"
HRM_SEED_OWNER_NAME="Owner"
HRM_SEED_OWNER_PHONE=""
HRM_SEED_OWNER_PASSWORD=""

# --- E2E tests guard ---
# Required to run scripts/e2e-test.sh against a non-test DB.
HRM_E2E_CONFIRM=""

# --- Deployment mode ---
# "single" (default) = single-instance PostgreSQL deployment; the in-memory
# rate limiter, camera token cache and BgJob tick are per-process.
# "multi" = multi-instance — requires Redis for rate limit + token cache +
# BgJob queue; setting it emits a boot ADVISORY naming those subsystems
# (see DEPLOYMENT-GUIDE.md §Multi-Instance).
HRM_DEPLOYMENT_MODE="single"

# --- Session policy overrides ---
# Override the 7-day session absolute expiry (clamped to 1-90 days).
HRM_SESSION_DAYS="7"

# --- Device plane (documented M-33: these were read by the gateway but never listed) ---
# How many days back the /iclock + ISAPI ingest accepts device events (default 7).
# HRM_DEVICE_INGEST_WINDOW_DAYS="7"
# ADMS realtime push handling; "false" buffers via the sweeper instead.
# ADMS_REALTIME="true"

# --- Maps (L-14) ---
# Tile server for the live-tracking / geo-fence maps. Default: public
# OpenStreetMap (viewer IPs are visible to OSM). Point this at an internal
# tile server for privacy-sensitive or air-gapped deployments.
# NEXT_PUBLIC_MAP_TILES_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"

# --- SaaS platform layer (public website / owner console / subscriptions) ---
# Owner console account created by the seeds. REQUIRED in production: the seeds
# refuse to create the owner super-admin with a default/weak password.
# Dev default (non-production only): SaasOwner@2026 — change it immediately.
#HRM_SAAS_OWNER_EMAIL="owner@yourdomain.com"
#HRM_SAAS_OWNER_NAME="Platform Owner"
#HRM_SAAS_OWNER_PASSWORD="change-me-min-12-chars"
# Include demo registrations/subscriptions when running the standalone SaaS seed
# (bun run seed:saas). The full demo seed always includes them.
#HRM_SAAS_SEED_DEMO="1"

# ---- Public website (CMS-driven) ---------------------------------------------
# Canonical site URL used for SEO metadata, sitemap and Open Graph. The whole
# public site (branding, pages, sections, features, clients, testimonials,
# SEO) is editable from the Owner Console → Platform Settings → Website Studio.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# ─────────────── Phase 1 (2026-10-21): secret rotation & per-context keys ───────────────
# SECURITY CONTRACT (see the 2026-10 codebase audit, SEC-1/SEC-13):
#   1. The three plane secrets below must NEVER appear in any tracked file.
#      Rotate once with:  bun run scripts/rotate-secrets.ts
#      Pre-commit/CI scan: bun run scripts/scan-secrets.ts   (ci.sh stage 5)
#   2. After rotating HRM_MFA_KEY you MUST re-encrypt the at-rest fields:
#        HRM_OLD_MFA_KEY=<the value you just replaced> \
#          bun run scripts/re-encrypt-fields.ts --apply
#      then restart. MFA TOTP secrets also self-heal lazily on next verify.
#   3. Per-context overrides (optional — leave empty to key every context with
#      HRM_MFA_KEY exactly as before Phase 1; setting one isolates that context's
#      rotation from all the others):
#      HRM_CAMERA_KEY=     # cameras::v*   (cloud credentials)
#      HRM_DEVICE_KEY=     # devices::v1   (attendance device comm keys)
#      HRM_WEBHOOK_KEY=    # webhooks::v1  (outbound signing secrets)
#      HRM_AI_KEY=         # ai::v1        (AI provider keys)
#      HRM_COMMS_KEY=      # comms::v1     (email/SMS gateway credentials)
#      HRM_PAYMENTS_KEY=   # saas-payments::v1 (bKash/Nagad/SSLCommerz credentials)
#      HRM_PII_KEY=        # pii::v1   (employee PII at rest: bank/MFS numbers,
#                                   #  document numbers, document files —
#                                   #  Phase 5 P6, audit F28)
#      HRM_PUSH_KEY=       # push::v1  (web-push VAPID private keys — Phase 5 P6)
#      (When a per-context key rotates, set HRM_OLD_<NAME>_KEY for the
#       re-encrypt pass the same way as HRM_OLD_MFA_KEY above.)


# ─────────────── Phase 3 (2026-10-22): platform scale & mobile v1.1 ───────────────
# See CHANGES-2026-10-22-PHASE3.md for the full workstream breakdown.

# ---- WS-B: multi-instance coordination (SCL-21) --------------------------------
# Optional Redis for distributed locks + shared rate buckets. When unset (or
# unreachable) the platform uses the ALWAYS-AVAILABLE Postgres backend
# (CoordinationLock rows) — multi-instance deployments are safe with ZERO new
# infrastructure. Redis is deliberately confined to locks/buckets/cache: the
# BgJob queue stays in Postgres.
#REDIS_URL="redis://:password@redis-host:6379/0"

# ---- WS-C: backup hardening (OPS-1/2/3) ----------------------------------------
# Point the DUMP at a read replica so pg_dump never loads the serving primary
# (falls back to DATABASE_URL when unset).
#HRM_BACKUP_SOURCE_URL="postgresql://hrm_user:pass@replica-host:5432/hrm"
# Artifacts are AES-256-CBC encrypted at rest when HRM_BACKUP_KEY is set
# (the same key scripts/backup.sh uses; set it — see the Phase 1 block above).
# PostgreSQL dumps now use pg_dump --format=custom (self-compressed, no
# in-process gzip stalling the event loop) and restore via pg_restore.

# ---- WS-E: webhook + campaign scale (OPS-5) ------------------------------------
# PENDING webhook deliveries older than this many days are dead-lettered
# (FAILED) by the daily sweep. Default 7.
#HRM_WEBHOOK_BACKLOG_DAYS="7"
# Recipients processed per campaign pass (the tick resumes the remainder on
# subsequent passes; bounded so one campaign never hogs a tick). Default 200.
#HRM_CAMPAIGN_BATCH="200"

# ---- WS-D: public API v1.1 (MOB-1..6) ------------------------------------------
# Fraction of API-v1 READ requests that write an audit row (0..1; writes are
# ALWAYS audited). Default 0.1. Set 1 to restore the pre-Phase-3 always-audit
# behavior, 0 to disable read audits entirely.
#HRM_API_AUDIT_SAMPLE_RATE="0.1"
# User access-token TTL (seconds, default 900) and refresh-token TTL (days,
# default 30) for /api/v1/auth/token.
#HRM_API_ACCESS_TTL_SEC="900"
#HRM_API_REFRESH_TTL_DAYS="30"

# ============================================================================
# Phase 4 (2026-10-22) — Hardening & End-State
# ============================================================================

# ---- WS-D: platform hygiene (SEC-16) -------------------------------------------
# SaaSAuditLog (platform audit: owner actions + one NOTIFICATION_* row per
# email sent) retention in days. Default 730 (2 years). An EXPLICIT 0
# DISABLES the sweep (parsed without the falsy-|| trap). The per-tenant
# AuditLog keeps its own 5-year policy independently.
#HRM_SAAS_AUDIT_RETENTION_DAYS="730"

# ---- WS-E: performance-budget gate (§11.1) -------------------------------------
# The three switches below are TEST-TIME ONLY (scripts/ci.sh stage 13 and the
# nightly lane) — they never affect production behavior:
#   HRM_QUERY_COUNT=1            instrument Prisma query counts (the caps)
#   HRM_PERF_PROFILE=nightly     raised iteration counts; pair with
#                                scripts/seed-scale.ts (5000-employee tenant +
#                                100000-vendor fleet)
#   HRM_PERF_BASELINE_UPDATE=1   refresh tests/perf-baseline.json (deliberate
#                                performance changes only — the diff is the
#                                review artifact)
# The golden payslip corpus (tests/golden/payslips/*.json) is regenerated
# deliberately with HRM_GOLDEN_REGEN=1 — see CHANGES-2026-10-22-PHASE4.md.
