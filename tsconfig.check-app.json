{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "src/hrm/**/*",
    "src/saas/**/*",
    "src/app/**/*",
    "src/components/**/*",
    "src/hooks/**/*",
