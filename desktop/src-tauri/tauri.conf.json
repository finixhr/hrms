{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Finix HR",
    "version":  "1.0.0",
    "identifier":  "com.finixhr.desktop",
    "build":  {
                  "beforeDevCommand":  "",
                  "devUrl":  null,
                  "beforeBuildCommand":  "",
                  "frontendDist":  "../ui"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Finix HR",
                                    "width":  1280,
                                    "height":  800,
                                    "minWidth":  900,
                                    "minHeight":  600,
                                    "resizable":  true,
                                    "fullscreen":  false
                                }
                            ],
                "withGlobalTauri":  true,
                "security":  {
                                 "csp":  "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; frame-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
                             }
            },
    "plugins":  {
                    "updater":  {
                        "endpoints":  [
                            "https://releases.finixhr.example/finix-hr-desktop/{{target}}/{{arch}}/{{current_version}}"
                        ],
                        "dialog":  true,
                        "pubkey":  "RWTXEKDKcQsUKTLH8Pw/qzrFZ4UMfMnuTLdymMbmfAZHDawr4+TdyAiL"
                    }
                },
    "bundle":  {
                   "active":  true,
                   "createUpdaterArtifacts":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "resources":  {

                                 },
                   "externalBin":  [

                                   ],
                   "copyright":  "",
                   "category":  "Business",
                   "shortDescription":  "Finix HR — Human Resources Management",
                   "longDescription":  "Finix HR desktop application for Windows and macOS, wrapping the full Finix HR web application in a native window.",
                   "windows":  {
                                   "certificateThumbprint":  "250456C96E034A86C2581EC81B1D044347AB71C4",
                                   "digestAlgorithm":  "sha256",
                                   "timestampUrl":  "http://timestamp.digicert.com"
                               },
                   "macOS":  {
                                 "minimumSystemVersion":  "",
                                 "exceptionDomain":  "",
                                 "signingIdentity":  "-",
                                 "providerShortName":  null,
                                 "entitlements":  null
                             }
               }
}
