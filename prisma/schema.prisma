// ============================ FINANCIAL HR ============================

model Loan {
  id                   String    @id @default(cuid())
  vendorId             String
  employeeId           String
  type                 String    @default("PERSONAL") // PERSONAL | HOUSING | MEDICAL | EMERGENCY | OTHER
  principal            Float
  interestRate         Float     @default(0)
  installmentAmount    Float     @default(0)
  installments         Int       @default(1)
  startDate            String
  endDate              String?
  paidAmount           Float     @default(0)
  outstanding          Float     @default(0)
  status               String    @default("PENDING") // PENDING | APPROVED | REJECTED | ACTIVE | CLOSED
  purpose              String?
  // Guarantor consent flow (spec §10.1): requester names a colleague as guarantor;
  // the loan enters the approval workflow only after the guarantor agrees.
  guarantorId          String?
  guarantorStatus      String? // null = none | PENDING | AGREED | DECLINED
  guarantorRespondedAt DateTime?
  guarantorNote        String?
  journalDisburseId    String?
  approvalRequestId    String?
  // H-10 — money table: Restrict (loan history pins the employee row).
  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  approvedBy           String?
  actedAt              DateTime?
  createdAt            DateTime  @default(now())

  @@unique([vendorId, id]) // H-10 — structural tenant scoping
  @@index([vendorId, status])
  @@index([vendorId, employeeId])
  @@index([vendorId, guarantorId, guarantorStatus])
}

model LoanInstallment {
  id             String    @id @default(cuid())
  // DB-02 (R5) — child tables carry their tenant explicitly (backfilled from Loan).
  vendorId String
  loanId         String
  no             Int
  dueDate        String
  amount         Float
  paidAmount     Float     @default(0)
  payrollEntryId String?
  paidAt         DateTime?
  status         String    @default("PENDING") // PENDING | PAID | PARTIAL | OVERDUE

  @@unique([vendorId, loanId, no])
  @@index([vendorId, loanId])
}

model Advance {
  id                String    @id @default(cuid())
  vendorId          String
  employeeId        String
  amount            Float
  reason            String?
  requestDate       String
  recoveryDate      String?
  installments      Int       @default(1)
  deducted          Float     @default(0)
  outstanding       Float     @default(0)
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED | RECOVERING | RECOVERED
  approvalRequestId String?
  approvedBy        String?
  actedAt           DateTime?
  journalId         String?
  // 2026-10-14 — guarantor fallback for salary advances: when the borrower
  // has no payable salary in a period (absent the whole period / off the
  // payroll), the monthly recovery deducts from this designated colleague's
  // salary instead (Payroll → Loan & Advance Control). Advances are created
  // by HR, so the guarantor designation takes effect immediately (loans keep
  // their ESS consent flow — spec §10.1).
  guarantorId       String?
  guarantorStatus   String? // null = none | AGREED (HR-designated)
  createdAt         DateTime  @default(now())

  @@index([vendorId, status])
  @@index([vendorId, employeeId])
  @@index([vendorId, guarantorId, guarantorStatus])
}

model ExpenseClaim {
  id                String    @id @default(cuid())
  vendorId          String
  employeeId        String
  category          String // TRAVEL | FOOD | MEDICAL | OFFICE | TRANSPORT | CLIENT | OTHER
  title             String
  amount            Float
  approvedAmount    Float?
  date              String
  description       String?
  branchId          String?
  projectRef        String?
  receiptName       String?
  receiptData       String?
  paymentMethod     String    @default("BANK")
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED | REIMBURSED
  reimbursementDate String?
  approvalRequestId String?
  approvedBy        String?
  actedAt           DateTime?
  journalId         String?
  createdAt         DateTime  @default(now())

  @@index([vendorId, status])
  @@index([vendorId, employeeId])
}

// Accounting integration (journal entries posted into ERP chart of accounts)
model AccountJournal {
  id             String   @id @default(cuid())
  vendorId       String
  refType        String // PAYROLL | LOAN_DISBURSE | LOAN_RECOVERY | ADVANCE_PAY | ADVANCE_RECOVER | EXPENSE | SETTLEMENT | AIT | JOURNAL_VOUCHER
  refId          String?
  idempotencyKey String?  @unique // H-3 — money-path backstop: one posting per business event
  date           String
  memo           String
  linesJson      String // [{account, accountName, debit, credit}]
  amount         Float
  source         String   @default("HRM")
  // ---- Wave 3 WP-B (2026-10-08) — manual voucher approval workflow ----
  // POSTED default keeps every auto-generated journal (payroll/loans/expenses)
  // and all pre-existing rows untouched; only MANUAL vouchers ever carry
  // DRAFT/PENDING_APPROVAL/REJECTED. Posted money history stays immutable.
  status         String   @default("POSTED") // DRAFT | PENDING_APPROVAL | POSTED | REJECTED
  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?
  rejectionReason String?
  // ---- Wave 4 WP-B (2026-10-08) — optional cost-center tag (manual vouchers)
  costCenterId   String?
  createdAt      DateTime @default(now())

  @@index([vendorId, refType])
  @@index([vendorId, date])
  @@index([vendorId, status])
  @@index([vendorId, costCenterId])
}

