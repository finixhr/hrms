// ================= REMEDIATION — supporting models =================

// M-22 — race-safe sequential code generation. Count+1 code generation collides
// under concurrent creates (letters, org units); this counter table makes the
// increment atomic at the database level (UPDATE ... RETURNING semantics).
model SequenceCounter {
  key   String @id // e.g. "<vendorId>:letters" — scoped, stable keys
  value Int    @default(0)
}

// Approval delegation (audit §L — missing feature): a user temporarily
// delegates their approval authority to another user for a date window.
// The engine honors ACTIVE delegations in canActOnStep and stamps the action.
model ApprovalDelegate {
  id         String   @id @default(cuid())
  vendorId   String
  fromUserId String
  toUserId   String
  startDate  String
  endDate    String
  reason     String?
  active     Boolean  @default(true)
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([vendorId, toUserId, active])
  @@index([vendorId, fromUserId])
}

// ================= PROVIDENT FUND (PF) =================
// Additive module: vendor-level rules live in HrSettings group "pf";
// per-employee enrollment + contribution ledger live here. The payroll engine
// computes the employee deduction (payroll.ts calculateRun) and rows are
// written when the run is PAID (payRun transaction) — same money-path
// discipline as loans/advances.

// Employee PF enrollment (one row per employee per vendor).
model PfEnrollment {
  id          String    @id @default(cuid())
  vendorId    String
  employeeId  String
  enrollDate  String // ISO date
  status      String    @default("ACTIVE") // ACTIVE | PAUSED | CLOSED
  employeePct Float     @default(10) // % of basis withheld from the employee
  employerPct Float     @default(10) // % of basis contributed by the employer
  basis       String    @default("BASIC") // BASIC | GROSS — inherited default, may override config
  note        String?
  closedAt    DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([vendorId, employeeId])
  @@index([vendorId, status])
}

// Immutable contribution ledger — appended by payroll payment, manual entry
// or opening balance import. Balance = Σ employeeAmount + employerAmount.
model PfContribution {
  id             String   @id @default(cuid())
  vendorId       String
  employeeId     String
  periodYear     Int
  periodMonth    Int
  employeeAmount Float    @default(0)
  employerAmount Float    @default(0)
  source         String   @default("PAYROLL") // PAYROLL | MANUAL | OPENING | WITHDRAWAL
  runId          String? // PayrollRun that generated this row (PAYROLL only)
  note           String?
  // MON-3 (Phase 1) — sha256(note), with the creating run folded in for
  // PAYROLL rows; the component that makes the below unique key work with
  // NULL-able notes (Postgres treats NULLs as distinct, so a plain note
  // column could never back a unique constraint). Computed at every write
  // site via pfNoteHash(); backfilled by the 9_wave9zc_pf_contribution_dedupe_unique_20261021 migration.
  noteHash       String   @default("")
  createdBy      String?
  createdAt      DateTime @default(now())

  @@index([vendorId, employeeId, periodYear, periodMonth])
  @@index([vendorId, runId])
  // MON-3 — import idempotency: a retried/double-uploaded row is the SAME row.
  @@unique([vendorId, employeeId, periodYear, periodMonth, source, noteHash])
}

// ================= AIT / INCOME TAX — Income Tax Act 2023 =================
// Fully configuration-driven engine: NOTHING about rates, thresholds, slabs,
// exemptions, minimum tax or rebate percentages is hardcoded. Every number
// lives in these per-fiscal-year tables so a new Finance Act year is a
// configuration change, never a code change.
//
// Legal anchors: Sec 86 (TDS on salary), Sec 32 + Third Schedule (salary
// definition & exemption), First Schedule Part A (slab rates), Sec 164
// (minimum tax), Sec 78 (investment rebate), Sec 166 (statement/reconciliation).

// One row per fiscal year per vendor. Only ONE may be active at a time.
model AitFiscalYear {
  id                 String                @id @default(cuid())
  vendorId           String
  label              String // "FY 2025-26"
  incomeYear         String // "2025-26" (year the income is earned)
  assessmentYear     String // "2026-27" (year the return is filed)
  tdsSectionRef      String                @default("Section 86, Income Tax Act 2023")
  // Salary exemption rule (Third Schedule): exempt = MIN(annualGross × fraction, cap)
  exemptionFraction  Float                 @default(0.3333333333) // 1/3
  exemptionCap       Float                 @default(500000)
  // Minimum tax (Sec 164) — WARNING ONLY, never auto-inflates TDS
  minimumTax         Float                 @default(5000)
  // Investment rebate (Sec 78, ITA 2023 as consolidated June 2025): rebate =
  // LOWER OF (a) rebateIncomeCapPercent% of taxable income [A base], (b)
  // rebateRatePercent% of eligible investment [B], (c) rebateCapAmount (absolute).
  // r8 audit (2026-10-14): previously implemented as 15% x MIN(investment,
  // 25% of taxable, 1 crore) — legally wrong in all three limbs.
  rebateRatePercent      Float                 @default(15)
  rebateCapFraction      Float                 @default(0.25) // LEGACY pre-r8 — kept for audit trail, NOT used by the engine
  rebateCapAmount        Float                 @default(10000000)
  rebateIncomeCapPercent Float                 @default(3) // §78(a) — 3% of taxable income cap
  newTaxpayerMinimumTax  Float?                // ৳1,000 floor for first-time return filers (AY 2026-27+); null = N/A
  surchargeJson          String?               // net-wealth surcharge bands per year (FO 2025 / FA 2026); null = engine default table
  // Festival bonus default for annual projection: N × monthly basic
  festivalBonusCount Float                 @default(2)
  active             Boolean               @default(false)
  notes              String?
  createdBy          String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  categories         AitTaxpayerCategory[]
  slabs              AitTaxSlab[]

  @@index([vendorId, active])
}

// Taxpayer-category thresholds (First Schedule, Finance Ordinance 2025).
// Category labels are free-form — the engine matches by key.
model AitTaxpayerCategory {
  id           String        @id @default(cuid())
  vendorId     String
  fiscalYearId String
  key          String // general | female | senior | disabled | freedom_fighter | …
  label        String // display label (bilingual-friendly)
  threshold    Float // tax-free threshold for this category
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  fiscalYear   AitFiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@unique([fiscalYearId, key])
}

// Ordered cumulative progressive slabs. `upperLimit` null = balance (no cap).
// The engine loops ANY number of slabs in `order` — never assumes a count.
model AitTaxSlab {
  id           String        @id @default(cuid())
  vendorId     String
  fiscalYearId String
  order        Int // 1..N
  slabLabel    String // "First ৳3,00,000"
  upperLimit   Float? // width of this slab band; null = remaining balance
  ratePercent  Float // 10 | 15 | 20 | 25 | 30 …
  createdAt    DateTime      @default(now())
  fiscalYear   AitFiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@index([fiscalYearId, order])
}

// Immutable audit journal: every calculation (preview/save/batch/payroll)
// records the FULL config snapshot + inputs + outputs. Payroll-finalized
// rows are part of the money record and are never rewritten.
model AitCalculationLog {
  id           String   @id @default(cuid())
  vendorId     String
  fiscalYearId String?
  employeeId   String?
  employeeCode String?
  employeeName String?
  kind         String // PREVIEW | SAVE | BATCH | PAYROLL | RECONCILIATION
  inputsJson   String // full input set
  configJson   String // config snapshot used (thresholds/slabs/rates at calc time)
  outputJson   String // full 14-line breakdown
  warningsJson String   @default("[]")
  runId        String? // PayrollRun link for PAYROLL rows
  operatorId   String?
  operatorName String?
  createdAt    DateTime @default(now())

  @@index([vendorId, createdAt])
  @@index([vendorId, employeeId])
  @@index([vendorId, runId])
}

// ================= PASSWORD RESET (login recovery) =================
// Single-use, hashed-at-rest tokens. The raw token only ever exists in the
// reset link handed to the user (email) — the DB keeps sha256(token+salt).
// HIGH-3 (this audit) — the PasswordResetToken model was declared but never
// queried (grep db.passwordResetToken src/ → 0 hits). The reset flow lives on
// the User.passwordResetToken String field instead (auth.ts:159-233).
//
// Decision: rather than carry dead code with intended-but-unused audit
// features, we drop the model. If a future audit cycle wants to migrate the
// reset flow to a dedicated table (for requestedIp audit + multi-token
// concurrency), a new migration will re-add it. For now: ship ONE source of
// truth (the User column) — do not ship both.
//
// (model removed)

