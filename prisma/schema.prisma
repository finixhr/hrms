// ================= M-04/M-05 — background job queue =================
// Heavy fan-out operations (communications.send up to 1,000 recipients,
// payslips.emailAll, backups.export) return a job ID immediately and run in
// the jobs.ts worker lane; clients poll jobs.get for progress + result.
model BgJob {
  id            String    @id @default(cuid())
  vendorId      String
  type          String // COMMUNICATION_SEND | PAYSLIP_EMAIL_ALL | BACKUP_EXPORT | …
  payloadJson   String    @default("{}")
  status        String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED | CANCELLED | DEAD (WP-A)
  progress      Int       @default(0)
  total         Int       @default(0)
  resultJson    String?
  error         String?
  // ---- WP-A (2026-10-08) — production-grade queue fields (additive) ----
  priority      Int       @default(5) // lower runs first (0=highest, 9=lowest)
  scheduledFor  DateTime? // null = immediately eligible
  attempts      Int       @default(0) // completed execution attempts
  maxAttempts   Int       @default(3) // retries before DEAD (dead-letter)
  cancelledAt   DateTime? // set when an admin/user cancels (cooperative)
  lastErrorAt   DateTime?
  runLogJson    String? // append-only attempt history [{startedAt,finishedAt,error,durationMs}]
  createdBy     String?
  createdByName String?
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  @@unique([vendorId, id]) // H-10 — structural tenant scoping
  @@index([vendorId, status])
  @@index([status, priority, createdAt]) // WP-A — the claim scan (priority-aware)
  @@index([vendorId, type, status])
}

// ================= M-06 — persistent throttle buckets =================
// Rate-limit state moved out of process memory into SQLite (survives restarts
// and is shared across workers in single-instance deployments). Multi-instance
// deployments need Redis — documented in SETUP.md. Fixed-window counters;
// expired rows are swept by the jobs tick.
model Throttle {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

// ================= Camera Manager — CCTV for tenants =================
// Brand-agnostic CCTV registry. Tenants (ecommerce vendors) register their
// Hikvision / Dahua / EZVIZ / Imou cameras here; live viewing is handed off
// to the brand's own cloud app via a launch target (deep link / QR / cloud
// stream token). NO video bytes flow through this server — see
// src/hrm/CONVENTIONS.md and src/hrm/API.md for the broader app conventions.
//
// Scoping: row-level multi-tenancy via vendorId (matches the rest of the
// schema). BRANCH_MANAGER is further restricted to their own branchId via
// cameraScopeFilter(ctx) in src/hrm-server/cameras/repository.ts (mirrors
// deviceScopeFilter in routes/devices.ts). Point lookups use
// assertTenant(rec, ctx) → 404, never 403, to prevent cross-tenant ID
// enumeration. The H-10 structural composite @@unique([vendorId, id]) is
// present on both tables for future FK joins (every FK-targeted table in
// this schema has it — Employee, LeaveRequest, PayrollRun, PayrollEntry,
// Loan, BgJob). AttendanceDevice omits it only because nothing FKs to it;
// Camera and CameraCredential are different.
//
// Brand credentials split by brand class (Camera Manager §8):
//   - Hikvision / Dahua  → per-camera; serialNumber + verificationCode live
//                          on the Camera row (below). No CameraCredential row.
//   - EZVIZ / Imou       → per-tenant-per-brand; {appKey, appSecret} or
//                          {appId, appSecret} sealed in CameraCredential.
//
// CRITICAL: do NOT copy AttendanceDevice.commKey's plaintext-at-rest pattern
// here. That field is a documented legacy exception (C-03). Camera cloud
// credentials (EZVIZ/Imou appKey/appSecret) MUST be encrypted at rest via
// crypto-field.ts (encryptField(plain, "cameras::v1")) and MUST be
// decryptable server-side to call provider APIs. Never plaintext. Never
// hash-only. See CameraCredential.encryptedPayload below.

model Camera {
  id                String    @id @default(cuid())
  vendorId          String
  brand             String // HIKVISION | DAHUA | EZVIZ | IMOU — String, not enum (SQLite has no native enum)
  name              String
  model             String?
  serialNumber      String? // vendor-scoped informational serial (matches AttendanceDevice.serialNumber naming); not globally unique — cameras have no inbound webhook (§12)
  channel           Int       @default(1) // stream/channel number for multi-channel NVRs
  verificationCode  String? // Hikvision/Dahua per-device verifier (lives on Camera row, not CameraCredential — see Camera Manager §8)
  branchId          String? // → Branch.id (location FK; null = unassigned)
  location          String? // free-text sub-location within the branch ("Gate 2", "Reception")
  installDate       String? // ISO date — user-entered dates in this codebase are String (Employee.dob, Holiday.date, Promotion.effectiveDate); only machine timestamps are DateTime
  status            String    @default("UNKNOWN") // ONLINE | OFFLINE | UNKNOWN
  lastStatusCheckAt DateTime? // when the server last polled the brand cloud API
  lastSeenAt        DateTime? // brand-API last contact (distinct from lastStatusCheckAt)
  lastError         String? // status-check failure reason ("EZVIZ token expired") — never include credentials; mirrors AttendanceDevice.lastError
  enabled           Boolean   @default(true) // soft delete/deactivation — history is preserved (mirrors AttendanceDevice.enabled)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt // matches AttendanceDevice exactly (double annotation)

  @@unique([vendorId, id]) // H-10 — structural tenant scoping for joins
  @@unique([vendorId, serialNumber, channel]) // composite — NULL serialNumber treated as distinct per SQLite (accepted; cameras may pre-register)
  @@index([vendorId])
  @@index([vendorId, brand]) // serves brand-filtered listing
  @@index([vendorId, branchId]) // serves branch-scoped queries for BRANCH_MANAGER
  @@index([vendorId, enabled]) // serves the default enabled=true list filter
}

// CameraCredential — per-vendor+brand cloud-account credentials for EZVIZ/Imou.
// Hikvision/Dahua use Camera.verificationCode instead and never write here.
// One row per vendor+brand, NEVER per camera: a nullable cameraId in a unique
// constraint would not stop two account-level rows for the same vendor+brand
// (SQLite treats NULL as distinct in unique constraints — Camera Manager §7).
// encryptedPayload is sealed via crypto-field.ts (extracted Phase 3) with the
// "cameras::v1" context. encryptionKeyVersion is the camera-specific rotation
// counter — MFA keeps its own "v2:" string prefix; the two mechanisms stay
// separate on purpose (TODO(crypto-unification) — future cleanup).
model CameraCredential {
  id                   String    @id @default(cuid())
  vendorId             String
  brand                String // EZVIZ | IMOU (HIKVISION/DAHUA use Camera.verificationCode instead)
  encryptedPayload     String // {appKey, appSecret} or {appId, appSecret} JSON, sealed via crypto-field.ts (encryptField(plain, "cameras::v1")) — NEVER plaintext, NEVER hash-only
  encryptionKeyVersion Int       @default(1) // camera-specific rotation counter; MFA uses its own "v2:" prefix (kept separate — TODO(crypto-unification))
  createdAt            DateTime  @default(now())
  rotatedAt            DateTime?

  @@unique([vendorId, id]) // H-10 — structural tenant scoping for joins
  @@unique([vendorId, brand])
  @@index([vendorId])
}


// ============================================================================
// ================= SaaS PLATFORM LAYER (public site + owner panel) ==========
// ============================================================================
// Added for the SaaS business layer (marketing website, prospective-customer
// registration, plan/subscription entitlements, SaaS-owner control panel).
//
// PLANE SEPARATION (hard requirement): these models belong to the PLATFORM
// plane, not the tenant plane. Tenant models all carry `vendorId`; the
// platform models either carry no tenant reference (SaasPlan, SaasOwnerUser,
// SaasSetting) or reference Vendor only as a *customer* record
// (SaasSubscription.vendorId = "which tenant bought this plan").
// The existing tenant HRM code NEVER queries these tables, and the owner
// plane NEVER writes tenant business data. Cross-plane access happens in
// exactly two audited, server-side places: tenant provisioning (approval)
// and entitlement resolution (read-only).
//
// Naming: SaaS* prefix keeps the platform tables grouped together in the
// generated client (db.saasPlan, db.saasOwnerUser, …) — easy to audit that
// no tenant route ever touches them.

// ---- Plans: what a customer can buy ----------------------------------------
// Prices/limits are normalized columns (NOT one JSON blob) so the owner can
// filter/sort on them and future billing can compute from them safely.
// Entitlement feature flags mirror the HRM module keys they gate.
model SaasPlan {
  id                 String    @id @default(cuid())
  name               String
  tagline            String? // short marketing line ("For growing organizations")
  description        String?
  monthlyPrice       Decimal   @db.Decimal(12, 2) @default(0)
  yearlyPrice        Decimal   @db.Decimal(12, 2) @default(0)
  currency           String    @default("BDT") // ISO 4217; single platform currency per plan
  // ---- capacity limits (null = unlimited — Enterprise convention) ----
  employeeLimit      Int?
  userLimit          Int?
  branchLimit        Int?
  departmentLimit    Int?
  deviceLimit        Int?
  storageGb          Int? // platform storage quota
  trackingEmployeeLimit Int?
  // ---- module entitlements (what the subscription unlocks) ----
  payrollEnabled     Boolean   @default(false)
  aitEnabled         Boolean   @default(false)
  inventoryEnabled   Boolean   @default(false)
  procurementEnabled Boolean   @default(false)
  performanceEnabled Boolean   @default(false)
  essEnabled         Boolean   @default(true) // employee self-service portal
  cameraEnabled      Boolean   @default(false)
  trackingEnabled    Boolean   @default(false) // live employee tracking
  geofenceEnabled    Boolean   @default(false) // geo-fence management
  apiAccess          Boolean   @default(false)
  advancedReports    Boolean   @default(false)
  // ---- Wave 2 WP-M (2026-10-08) — Field Force premium feature ----
  fieldForceEnabled  Boolean   @default(false)
  supportLevel       String    @default("STANDARD") // STANDARD | PRIORITY | DEDICATED
  // ---- 2026-10-25 custom plans (master prompt Part G §12) ----
  // A custom plan is tenant-specific: isCustom + customForVendorId binds it
  // to ONE tenant; it never appears in the public catalog (isPublic=false).
  // billingMode: RECURRING (monthly/yearly price) | ONE_TIME (single charge).
  // For ONE_TIME: oneTimeValidityDays null = explicitly non-expiring;
  // a number = fixed validity window from assignment.
  billingMode          String    @default("RECURRING") // RECURRING | ONE_TIME
  oneTimeValidityDays  Int?
  isCustom             Boolean   @default(false)
  customForVendorId    String?
  // ---- storefront / lifecycle ----
  isPublic           Boolean   @default(true) // listed on /pricing
  active             Boolean   @default(true) // purchasable/assignable
  isTrialPlan        Boolean   @default(false)
  badge              String? // pricing-card highlight ("Most Popular")
  sortOrder          Int       @default(0)
  isDemo             Boolean   @default(false) // seeded sample — never counted as real production data
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  subscriptions SaasSubscription[]
  registrations SaasRegistration[]

  @@index([active, isPublic, sortOrder])
  @@map("SaaSPlan")
}

// ---- Subscription: one CURRENT subscription row per tenant -----------------
// History is preserved via SaasSubscriptionEvent (append-only); changing a
// plan updates this row and records the previous state as an event.
model SaasSubscription {
  id               String   @id @default(cuid())
  vendorId         String   @unique // one current subscription per tenant
  vendor            Vendor  @relation(fields: [vendorId], references: [id])
  planId           String
  plan             SaasPlan @relation(fields: [planId], references: [id])
  planName         String // snapshot at assignment (plans can be renamed/archived)
  billingCycle     String   @default("MONTHLY") // MONTHLY | YEARLY
  // TRIAL | PENDING_PAYMENT | ACTIVE | PAST_DUE | GRACE_PERIOD | EXPIRED | SUSPENDED | CANCELLED
  status           String   @default("ACTIVE")
  startDate        DateTime @default(now())
  // endDate null = explicitly non-expiring one-time entitlement (master
  // prompt §12.1C). Recurring subscriptions always carry a concrete endDate.
  endDate          DateTime? // computed from cycle at creation; extended on renewal
  // billing-mode snapshot at assignment — RECURRING | ONE_TIME (from the plan)
  billingMode      String   @default("RECURRING")
  gracePeriodDays  Int      @default(0)
  // pricing snapshot — the plan's price at assignment time; later plan edits
  // must never rewrite what an existing customer actually pays.
  priceAtCreation  Decimal  @db.Decimal(12, 2) @default(0)
  currencySnapshot String   @default("BDT")
  notes            String?
  createdBy        String? // owner user id
  createdByName    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  events SaasSubscriptionEvent[]
  invoices SaasInvoice[]

  @@index([status, endDate]) // renewal calendar lookups
  @@index([planId])
  @@map("SaaSSubscription")
}

// ---- Append-only subscription history --------------------------------------
model SaasSubscriptionEvent {
  id             String   @id @default(cuid())
  subscriptionId String
  subscription   SaasSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  vendorId       String
  type           String // CREATED | EXTENDED | UPGRADED | DOWNGRADED | CYCLE_CHANGED | SUSPENDED | REACTIVATED | CANCELLED | EXPIRED | GRACE_APPLIED | PLAN_CHANGED | OVERRIDE_CHANGED
  fromSnapshot   String? @default("{}") // JSON of prior state
  toSnapshot     String? @default("{}") // JSON of new state
  note           String?
  actorId        String? // owner user
  actorName      String?
  createdAt      DateTime @default(now())

  @@index([vendorId, createdAt])
  @@index([subscriptionId])
  @@map("SaaSSubscriptionEvent")
}

// ---- Registration applications (prospective customers) ---------------------
// The public /register form writes one row; NOTHING tenant-side is created
// until a SaaS owner approves it. The admin's chosen password is hashed here
// at submit time and is used to provision the tenant admin at approval —
// the password never travels again and is never stored in plaintext.
model SaasRegistration {
  id                String   @id @default(cuid())
  applicationNumber String   @unique // HRM-2026-000123 (platform sequence)
  // ---- organization ----
  organizationName  String
  organizationType  String? // PRIVATE_LTD | PLC | GOV | NGO | PARTNERSHIP | PROPRIETORSHIP | OTHER
  industry          String?
  website           String?
  address           String?
  city              String?
  country           String   @default("Bangladesh")
  contactNumber     String?
  officialEmail     String
  // ---- primary administrator ----
  adminName         String
  adminDesignation  String?
  adminEmail        String
  adminPhone        String?
  adminPasswordHash String // scrypt — becomes the tenant admin credential on approval
  // ---- requested scale ----
  employeeCount     Int      @default(0)
  branchCount       Int      @default(1)
  deviceCount       Int      @default(0)
  requestedModules  String   @default("[]") // JSON string[] of module keys
  // ---- plan preference ----
  planId            String?
  plan              SaasPlan? @relation(fields: [planId], references: [id])
  planName          String? // snapshot (plan may be archived later)
  billingCycle      String   @default("MONTHLY")
  // ---- lifecycle: PENDING | UNDER_REVIEW | PROVISIONING | APPROVED | REJECTED | SUSPENDED | CANCELLED ----
  // PROVISIONING is a transient claim status used by S1-001 conditional-claim fix
  // to prevent double-approval races; it is immediately replaced by APPROVED on success.
  status            String   @default("PENDING")
  // ---- review (owner-side) ----
  internalNote      String? // private to the SaaS team
  reviewNote        String? // shared on the status page (safe to show the applicant)
  rejectionReason   String?
  reviewedById      String?
  reviewedByName    String?
  reviewedAt        DateTime?
  requestedInfoAt   DateTime? // "request information" timestamp
  // ---- outcome ----
  approvedVendorId  String? // set on approval — links application → tenant
  subscriptionId    String?
  isDemo            Boolean  @default(false)
  source            String   @default("WEBSITE") // WEBSITE | ADMIN
  submitIp          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, createdAt])
  @@index([adminEmail])
  @@index([officialEmail])
  @@map("SaaSRegistration")
}

// ---- Per-tenant feature/storage overrides (owner support lever) ------------
// Distinct from plan entitlements: an owner can temporarily enable/disable a
// module for ONE tenant (support grace, enterprise negotiation, incident).
// Every change is audited and recorded in the subscription event log.
model SaasTenantOverride {
  id           String   @id @default(cuid())
  vendorId     String   @unique
  // JSON: { moduleKey: boolean } — only keys present override the plan value
  featureToggles String @default("{}")
  storageGbOverride Int?
  note         String?
  updatedById  String?
  updatedByName String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([vendorId])
  @@map("SaaSTenantOverride")
}

// ---- SaaS owner identities (completely separate from tenant users) ---------
// Roles: SUPER_ADMIN | ADMINISTRATOR | SALES_MANAGER | BILLING_MANAGER | SUPPORT_MANAGER
model SaasOwnerUser {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String
  passwordHash     String // scrypt, same format as tenant User.passwordHash
  roleKey          String   @default("ADMINISTRATOR")
  permissions      String   @default("[]") // JSON string[] of owner.* grants
  status           String   @default("ACTIVE") // ACTIVE | SUSPENDED
  lastLoginAt      DateTime?
  failedLoginCount Int      @default(0)
  lockedUntil      DateTime?
  mfaEnrolled      Boolean  @default(false) // platform-plane TOTP (owner console)
  // 2026-10-25 design systems — owner console design preference
  designPreference String?
  // self-service password recovery (sha-256 of the emailed token, mirroring
  // the tenant User.passwordResetToken discipline)
  passwordResetToken       String?
  passwordResetExpiresAt   DateTime?
  passwordResetRequestedAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  sessions         SaasOwnerSession[]
  mfaSecret        SaasOwnerMfaSecret?

  @@index([status])
  @@map("SaaSOwnerUser")
}

// ---- Owner-console roles & permissions (Owner Console → Roles & Permissions) --
// Platform-plane role definitions. The 5 built-in template roles (constants.ts
// OWNER_ROLE_TEMPLATES) are seeded here as isSystem=true rows on first access
// so they become viewable/editable in the console; custom roles are
// isSystem=false. Resolution order at login: explicit SaasOwnerUser.permissions
// grants, else this row (when active), else the static template. A deactivated
// role yields an EMPTY permission set (deny all) for template-derived users —
// explicit per-user grants still apply. isSystem roles cannot be deleted and
// their key is immutable; SUPER_ADMIN additionally cannot be deactivated.
model SaasOwnerRole {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  permissions String   @default("[]") // JSON string[] of owner.* grants
  isSystem    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@map("SaaSOwnerRole")
}

// ---- Owner MFA secret (mirrors the tenant UserMfaSecret shape exactly: ------
//      AES-256-GCM encrypted TOTP secret + sha-256 recovery-code hashes + the
//      M-16 replay counter. Separate table so a tenant MFA row can never be
//      confused with an owner one — same plane isolation as everything else.)
model SaasOwnerMfaSecret {
  id                String   @id @default(cuid())
  ownerId           String   @unique
  secretEnc         String // encrypted TOTP shared secret ("v2:" packed)
  recoveryCodesHash String   @default("[]") // JSON array of sha256 hashes
  lastUsedCounter   Int? // TOTP replay protection: highest accepted HMAC counter
  enrolledAt        DateTime @default(now())
  owner             SaasOwnerUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("SaaSOwnerMfaSecret")
}

// ---- Owner sessions (own cookie `saas_owner_session`; never mixes with
//      tenant Session rows — different table, different cookie name, different
//      dispatcher; a tenant user can never satisfy this lookup and vice versa)
model SaasOwnerSession {
  id         String   @id
  // SEC-02 (R5) — hashed-at-rest owner session tokens (same scheme as the
  // tenant plane; see the Session model note).
  tokenHash  String?  @unique
  ownerId    String
  expiresAt  DateTime
  csrfToken  String
  ip         String?
  userAgent  String?
  kind       String   @default("FULL") // FULL | MFA_PENDING | ENROLL_PENDING (pre-auth challenges)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  owner      SaasOwnerUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  // SCL-19 (Phase 2 WS5) — same purge-path index as Session
  @@index([expiresAt])
  @@map("SaaSOwnerSession")
}

// ============================ STORAGE ACCOUNTING ============================
// MOD-5 / SCL-6 prerequisite (Phase 2 WS6) — per-vendor storage rollup.
// The storage-quota check used to run FOUR SUM(LENGTH(column)) scans (every
// stored byte of the tenant) on every upload authorization; the owner console
// did the same PER VENDOR per page load. Upload authorization now reads this
// one row; write paths bump it incrementally (best-effort) and a nightly
// set-based reconciliation self-heals any drift.
model UsageRollup {
  vendorId     String   @id
  storageBytes BigInt   @default(0)
  reconciledAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("UsageRollup")
}

// ---- Phase 4 WS-D — per-tenant usage metering for billing ------------------
// A monthly, billing-grade usage series per tenant. The daily platform pass
// captures/refreshes the CURRENT month for every vendor in ONE set-based
// INSERT … ON CONFLICT (fleet-size independent); the last daily write of a
// month is that month's frozen end-of-month record. Billing reconciliation
// reads this series instead of re-deriving usage from live tables (which can
// only ever answer "now").
model UsageSnapshot {
  id               String   @id @default(cuid())
  vendorId         String
  periodYear       Int
  periodMonth      Int
  employeesTotal   Int      @default(0)
  employeesPayroll Int      @default(0) // payroll-scope statuses (the seats a run can pay)
  portalUsers      Int      @default(0) // active User rows (portal seats)
  devicesEnrolled  Int      @default(0) // enabled AttendanceDevice rows
  storageBytes     BigInt   @default(0) // the reconciled UsageRollup value
  capturedAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([vendorId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
}

// ---- SCL-21 (Phase 3 WS-B) — distributed coordination primitives ------------
// Postgres-backed lock rows: the ALWAYS-AVAILABLE backend for the distributed
// lock API (src/hrm-server/coordination.ts). When REDIS_URL is configured the
// Redis backend is preferred (SET NX PX + compare-and-del); this table is the
// zero-infra fallback that still makes a 2+-instance deployment safe, and the
// authoritative backend for single-instance deployments (one cheap upsert per
// claim). Claims are conditional (expiresAt takeover) so concurrent claimers
// can never both win — the same conditional-update discipline as BgJob.
model CoordinationLock {
  key       String   @id
  holder    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("CoordinationLock")
}

// ---- MOB-1 (Phase 3 WS-D) — mobile/client refresh tokens --------------------
// Opaque rotating refresh tokens for the /api/v1/auth/token endpoint. The RAW
// token is shown once at issuance; only sha256(raw) is stored. Rotation is
// per-family: presenting an already-rotated (revoked) token is treated as
// theft and revokes the ENTIRE family plus the backing Session. The access
// token itself is a short-lived JWT bound to the session (see _auth.ts).
model ApiRefreshToken {
  id         String    @id @default(cuid())
  vendorId   String
  userId     String
  sessionId  String
  tokenHash  String    @unique
  familyId   String
  scopesJson String    @default("[]")
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([familyId])
  @@index([userId])
  // DB-06 (R6) — the retention sweep deletes on expiresAt; without this index
  // the purge seq-scanned the whole table.
  @@index([expiresAt])
  @@index([vendorId])
  @@map("ApiRefreshToken")
}

// ---- Phase 5 P6 (WS-C) — Web Push subscriptions (RFC 8030/8291) --------------
// One row per browser/device subscription (the push service endpoint URL is
// globally unique — a re-subscribe upserts). Subscriptions are owned by the
// logged-in USER (vendorId + userId); dispatch walks this table, an HTTP 404/
// 410 from the push service deletes the row (the subscription is gone).
model PushSubscription {
  id            String    @id @default(cuid())
  vendorId      String
  userId        String
  endpoint      String    @unique
  p256dh        String // base64url, the subscription's ECDH P-256 public key
  auth          String // base64url, the subscription's auth secret
  platform      String    @default("web") // web | pwa | other
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  @@index([vendorId, userId])
  @@index([vendorId])
  @@map("PushSubscription")
}

// ---- OPS-5 (Phase 3 WS-E) — campaign bounce suppression list -----------------
// Hard-bouncing / failing addresses are re-mailed by every later campaign.
// Each FAILED send upserts a row (incrementing bounceCount); an address at or
// past BOUNCE_SUPPRESS_AFTER consecutive bounces is suppressed (journaled
// SKIPPED on future campaigns). Deleting the row re-enables the address.
model CampaignBounce {
  id           String   @id @default(cuid())
  channel      String // EMAIL | SMS
  address      String
  bounceCount  Int      @default(1)
  reason       String?
  lastBounceAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([channel, address])
  @@index([channel, lastBounceAt])
  @@map("CampaignBounce")
}

// ---- Platform audit log (separate from tenant AuditLog on purpose: ----------
//      platform events have no vendorId of their own; the affected tenant is
//      just the target. Keeps the owner console fast and the tenant audit view
//      free of platform noise.)
model SaasAuditLog {
  id        String   @id @default(cuid())
  actorId   String? // owner user id (null = system/public action)
  actorName String
  action    String // REGISTRATION_APPROVED | PLAN_CHANGED | TENANT_SUSPENDED | ...
  entity    String // SaasRegistration | SaasSubscription | Vendor | SaasPlan | ...
  entityId  String?
  vendorId  String? // affected tenant, when applicable
  summary   String
  metadata  String? @default("{}") // JSON: { from, to, reason, ... }
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([vendorId, createdAt])
  @@map("SaaSAuditLog")
}

// ---- Platform settings (no vendorId — these are global knobs) --------------
model SaasSetting {
  id        String   @id @default(cuid())
  group     String // general | registration | subscription | security | communication
  key       String
  value     String // JSON
  updatedAt DateTime @updatedAt

  @@unique([group, key])
  @@map("SaaSSetting")
}

// ---- Contact-form / sales inquiries from the public website ----------------
model SaasContactInquiry {
  id                String   @id @default(cuid())
  name              String
  email             String
  phone             String?
  company           String?
  inquiryType       String   @default("SALES") // SALES | SUPPORT | PARTNERSHIP | OTHER
  organizationSize  String? // "1-10" | "11-50" | "51-200" | "201-500" | "500+"
  modulesRequested  String   @default("[]") // JSON string[]
  message           String
  // NEW | IN_REVIEW | RESPONDED | CLOSED
  status            String   @default("NEW")
  handledById       String?
  handledByName     String?
  handleNote        String?
  handledAt         DateTime?
  submitIp          String?
  isDemo            Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([status, createdAt])
  @@map("SaaSContactInquiry")
}

// ---- Billing architecture (payment-gateway-ready; manual until a gateway ----
//      is connected — the owner records payments by hand, everything audited)
model SaasInvoice {
  id             String   @id @default(cuid())
  vendorId       String
  subscriptionId String?
  subscription   SaasSubscription? @relation(fields: [subscriptionId], references: [id])
  number         String   @unique // INV-2026-000123
  periodStart    DateTime
  periodEnd      DateTime
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("BDT")
  // Financial Tax Snapshot (2026-10-26) — preserves historical VAT % and net/tax amounts
  // at the time of invoice issuance. Changing platform VAT in the owner console never
  // mutates historical invoices or past Mushak-6.3 tax certificates.
  vatRatePercent Decimal  @default(5.00) @db.Decimal(5, 2)
  netAmount      Decimal  @default(0.00) @db.Decimal(12, 2)
  vatAmount      Decimal  @default(0.00) @db.Decimal(12, 2)
  // 2026-10-25 — invoice kind: TERM (renewal/initial term) | UPGRADE (prorated
  // plan-upgrade charge, applied on payment via changePlan semantics)
  kind           String   @default("TERM")
  // For kind=UPGRADE: the target plan the payment unlocks (validated at
  // settlement; the current plan is preserved until the payment is verified).
  upgradePlanId  String?
  // PENDING | PAID | FAILED | REFUNDED | CANCELLED
  status         String   @default("PENDING")
  issuedAt       DateTime @default(now())
  dueAt          DateTime?
  paidAt         DateTime?
  paymentMethod  String? // BANK | CASH | MFS | CARD (recorded when marked paid)
  transactionId  String?
  notes          String?
  // R12 (2026-10-12) — Accept-application invoices: set when the invoice was
  // issued by owner.registrations.accept (payment request BEFORE approval).
  // On owner.registrations.approve the row is linked to the new subscription.
  registrationId String?
  createdById    String?
  createdByName  String?
  createdAt      DateTime @default(now())

  payments SaasPayment[]

  @@index([vendorId, status])
  // Partial unique index created by migration 9_wave9zr_billing_idempotency_invoice_unique_20261026:
  // "SaaSInvoice_sub_term_period_unique" ON ("subscriptionId", "periodStart", "periodEnd")
  // WHERE "subscriptionId" IS NOT NULL AND "kind" = 'TERM' AND "status" != 'CANCELLED'
  // (Prisma DSL does not natively express partial WHERE indexes; enforced at Postgres layer)
  @@map("SaaSInvoice")
}

model SaasPayment {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        SaasInvoice @relation(fields: [invoiceId], references: [id])
  vendorId       String
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("BDT")
  method         String? // BANK | CASH | MFS | CARD
  transactionId  String?
  status         String   @default("PAID") // PENDING | PAID | FAILED | REFUNDED
  paidAt         DateTime @default(now())
  recordedById   String?
  recordedByName String?
  createdAt      DateTime @default(now())
  // ---- Wave 2 WP-I (2026-10-08) — online payment gateway checkout sessions ----
  // (migration 9_wave2_saas_ops_20261008 — originally 11_wave2_saas_ops_20261008,
  // renamed to fix alphabetical apply order; schema.sync completed by WP-H/I/J —
  // see the worklog.) Manual/owner-recorded rows keep provider "MANUAL" and a
  // NULL providerTxnId (Postgres unique treats NULLs as distinct, so manual
  // history is unaffected); gateway checkouts carry the provider id + session
  // id + the provider's own transaction id. @@unique([provider, providerTxnId])
  // is the IPN replay guard: one settled payment row per provider txn.
  provider       String   @default("MANUAL") // MANUAL | SSLCOMMERZ | BKASH | NAGAD | PAYSTATION | EPS
  providerTxnId  String?
  sessionId      String?
  failureReason  String?
  refundedAt     DateTime?
  metaJson       String   @default("{}")
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([vendorId])
  @@index([vendorId, status])
  @@unique([provider, providerTxnId])
  // ---- Wave 10 (2026-10-24) — provider-session lookup: the EPS merchant-portal
  // IPN carries only the gateway's own session reference (our payment row is
  // resolved through it when the query-string ref is stripped by the portal).
  // Migration 9_wave9zp_infra_support_payments_storage_sms_20261024.
  @@index([provider, sessionId])
  @@map("SaaSPayment")
}

// ============================================================================
// Website CMS (platform plane) — powers the fully owner-editable public site.
// Plane discipline (§ schema header): these tables hold PUBLIC MARKETING
// content only — never tenant business data. Rows are read by the public
// server components via src/hrm-server/saas/cms.ts (typed defaults merged
// over) and written exclusively through owner.cms.* RPC actions.
// ============================================================================

// One row per managed page. `slug` routes: "home" renders at "/", system
// feature pages render at /features/<slug>, custom pages at /p/<slug>.
model SaasCmsPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  pageType    String   @default("CUSTOM") // HOME | SYSTEM | CUSTOM
  status      String   @default("PUBLISHED") // DRAFT | PUBLISHED
  visible     Boolean  @default(true)
  sortOrder   Int      @default(0)
  showInNav   Boolean  @default(false)
  navLabel    String?
  seoTitle    String?
  seoDesc     String?
  blocks      String   @default("[]") // JSON: CmsBlock[]
  isSystem    Boolean  @default(false) // system pages cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pageType, status, sortOrder])
  @@map("SaaSCmsPage")
}

// Feature catalog for /features and /features/[slug]. `visual` selects the
// coded simulation component rendered on the detail page (never screenshots).
model SaasCmsFeature {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  navLabel   String
  headline   String
  sub        String
  visual     String? // key into VISUALS registry (e.g. "live-tracking")
  icon       String   @default("star")
  accent     String   @default("blue")
  sortOrder  Int      @default(0)
  visible    Boolean  @default(true)
  showOnHome Boolean  @default(true)
  content    String   @default("{}") // JSON: FeatureContent
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([visible, sortOrder])
  @@map("SaaSCmsFeature")
}

// Valued clients + their success stories / testimonials.
model SaasCmsClient {
  id          String   @id @default(cuid())
  name        String
  industry    String
  description String
  story       String?  @db.Text
  quote       String?
  personName  String?
  personRole  String?
  metrics     String   @default("[]") // JSON: {label, value}[]
  logoText    String?
  logoColor   String   @default("#2563eb")
  logoUrl     String?
  website     String?
  featured    Boolean  @default(false)
  visible     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([visible, sortOrder])
  @@map("SaaSCmsClient")
}

// Testimonials (may be standalone or attached to a client by name).
model SaasCmsTestimonial {
  id         String   @id @default(cuid())
  clientName String
  personName String
  personRole String
  quote      String   @db.Text
  rating     Int      @default(5)
  visible    Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([visible, sortOrder])
  @@map("SaaSCmsTestimonial")
}

// Media library for logo / favicon / images. Stored as data URLs (CSP allows
// img-src data:) so no filesystem dependency survives standalone builds.
model SaasCmsMedia {
  id        String   @id @default(cuid())
  name      String
  mimeType  String
  size      Int
  data      String   @db.Text // data URL (base64)
  // ---- WP-Q (2026-10-08) — Media Library 2.0 (additive) ----
  folder    String   @default("") // path string ("marketing/2026")
  tags      String   @default("[]") // JSON string[]
  alt       String?
  width     Int?
  height    Int?
  sizeBytes Int? // exact payload bytes (size keeps legacy meaning)
  sha256    String? // content hash — duplicate detection
  seoFilename String? // slugified, unique per folder
  variantsJson String? // optimized renditions [{kind, width, mime, data}]
  createdAt DateTime @default(now())

  @@index([sha256])
  @@index([folder])
  @@map("SaaSCmsMedia")
}

// Site-level CMS settings (identity, nav, footer, SEO, contact, homepage
// toggles). Key/value JSON without the 2000-char SaaSSetting clamp — media is
// referenced by SaasCmsMedia id and resolved to data URLs at read time.
model SaasSiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique // identity | nav | footer | seo | contact
  value     String   @db.Text // JSON
  updatedAt DateTime @updatedAt

  @@map("SaaSSiteSetting")
}


// ================= WP-K (Wave 2, 2026-10-08) — Employee Asset Management =================
// Fixed asset register with locked sequential codes (AST-0001 via
// SequenceCounter), assignment lifecycle and an append-only event log.
// Plain String FKs (employee/branch/item) + vendorId on every row: the
// H-10 structural tenant scoping convention used across the codebase.
model Asset {
  id            String    @id @default(cuid())
  vendorId      String
  code          String // AST-0001 — locked auto-generated (Wave 1 pattern)
  name          String
  category      String    @default("OTHER") // LAPTOP|DESKTOP|MOBILE|SIM|ID_CARD|ACCESS_CARD|MONITOR|VEHICLE|FURNITURE|OTHER
  brandModel    String?
  serialImei    String?
  purchaseDate  String? // ISO date
  purchaseCost  Float?
  warrantyExpiry String? // ISO date — warranty-expiring notifications
  condition     String    @default("NEW") // NEW|GOOD|FAIR|DAMAGED
  status        String    @default("IN_STOCK") // IN_STOCK|ASSIGNED|RETURNED|REPAIR|RETIRED|LOST
  branchId      String?
  locationNote  String?
  sourceItemId  String? // WP-L — inventory item this asset was issued from
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([vendorId, id]) // H-10 — structural tenant scoping
  @@unique([vendorId, code])
  @@index([vendorId, status])
  @@index([vendorId, category])
  @@index([vendorId, branchId])
  @@index([vendorId, warrantyExpiry])
}

model AssetAssignment {
  id           String    @id @default(cuid())
  vendorId     String
  assetId      String
  employeeId   String
  assignedAt   DateTime  @default(now())
  dueAt        DateTime?
  returnedAt   DateTime? // null = outstanding (WP-L exit clearance blocks on this)
  conditionOut String?
  conditionIn  String?
  note         String?
  issuedById   String?
  createdAt    DateTime  @default(now())

  @@unique([vendorId, id]) // H-10
  @@index([vendorId, assetId])
  @@index([vendorId, employeeId])
  @@index([vendorId, returnedAt])
}

model AssetEvent {
  id           String   @id @default(cuid())
  vendorId     String
  assetId      String
  type         String // ASSIGN|RETURN|REPAIR|RETIRE|LOSE|NOTE|CLEARED_WITH_DEDUCTION
  actorId      String?
  actorName    String?
  snapshotJson String   @default("{}") // append-only audit snapshot
  note         String?
  createdAt    DateTime @default(now())

  @@unique([vendorId, id]) // H-10
  @@index([vendorId, assetId, createdAt])
}

// ================= WP-M (Wave 2) — Field Force Management =================
// Visit locations are separate from attendance GeoFences (no coupling).
// Plans/visits reuse the tracking GPS + photo upload infrastructure.
model VisitLocation {
  id           String   @id @default(cuid())
  vendorId     String
  name         String
  address      String?
  lat          Float
  lng          Float
  radiusM      Int      @default(150)
  contactName  String?
  contactPhone String?
  note         String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([vendorId, id]) // H-10
  @@unique([vendorId, name])
  @@index([vendorId, active])
}

model VisitPlan {
  id         String   @id @default(cuid())
  vendorId   String
  employeeId String
  date       String // ISO date — one plan per employee per day
  note       String?
  createdAt  DateTime @default(now())

  @@unique([vendorId, id]) // H-10
  @@unique([vendorId, employeeId, date])
  @@index([vendorId, date])
}

model VisitPlanItem {
  id         String   @id @default(cuid())
  vendorId   String
  planId     String
  locationId String
  plannedFrom String? // HH:MM window
  plannedTo  String?
  tasks      String?
  createdAt  DateTime @default(now())

  @@unique([vendorId, id]) // H-10
  @@index([vendorId, planId])
}

model Visit {
  id               String    @id @default(cuid())
  vendorId         String
  planItemId       String? // null = ad-hoc visit
  employeeId       String
  locationId       String
  checkInAt        DateTime  @default(now())
  checkInLat       Float?
  checkInLng       Float?
  checkInAccuracy  Float?
  checkInPhotoId   String? // existing upload path (EXIF-stripped)
  checkOutAt       DateTime?
  checkOutLat      Float?
  checkOutLng      Float?
  durationMin      Int?
  status           String    @default("CHECKED_IN") // PLANNED|CHECKED_IN|COMPLETED|MISSED|CANCELLED
  remarks          String?
  createdAt        DateTime  @default(now())

  @@unique([vendorId, id]) // H-10
  @@index([vendorId, employeeId, checkInAt])
  @@index([vendorId, locationId])
  @@index([vendorId, status])
}

// ================= WP-P (Wave 2) — Recruitment + public Careers =================
model JobOpening {
  id             String   @id @default(cuid())
  vendorId       String
  title          String
  departmentId   String?
  branchId       String? // location label for the public card
  employmentType String   @default("FULL_TIME") // FULL_TIME|PART_TIME|CONTRACT|INTERN
  description    String?
  requirements   String?
  openings       Int      @default(1)
  salaryRange    String?
  deadline       String? // ISO date
  status         String   @default("DRAFT") // DRAFT|OPEN|PAUSED|CLOSED
  isPublic       Boolean  @default(false) // visible on the public /careers page
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([vendorId, id]) // H-10
  @@index([vendorId, status])
  @@index([vendorId, isPublic])
}

model JobApplication {
  id             String   @id @default(cuid())
  vendorId       String
  openingId      String
  name           String
  email          String?
  phone          String?
  expectedSalary Float?
  coverNote      String?
  cvFileId       String? // existing upload pattern
  source         String   @default("WEBSITE") // WEBSITE|MANUAL
  status         String   @default("NEW") // NEW|SHORTLISTED|INTERVIEW|OFFERED|HIRED|REJECTED
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([vendorId, id]) // H-10
  @@index([vendorId, openingId])
  @@index([vendorId, status])
  @@index([vendorId, createdAt])
}

// ================= WP-R (Wave 2) — backup & restore-drill register =================
model SaasBackupRun {
  id            String    @id @default(cuid())
  type          String // BACKUP | DRILL
  trigger       String    @default("MANUAL") // MANUAL | SCHEDULED
  status        String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  sizeBytes     Int?
  checksum      String? // sha256 of the artifact
  locationType  String    @default("LOCAL") // LOCAL | S3
  locationPath  String?
  retentionKept Int?
  error         String?
  reportJson    String? // drill results (row-count comparison, verification)
  createdAt     DateTime  @default(now())

  @@index([type, startedAt])
}

// ---- Wave 3 WP-C (2026-10-08) — tenant plan-change requests -------------
// Tenants whose roles lack billing.manage submit an upgrade/downgrade
// request; the owner console approves (applying the same changePlan
// semantics as the Billing portal) or rejects it. Plain String FK columns
// (no Prisma relations) per the H-10 vendor-scoping convention.
model SaasPlanChangeRequest {
  id               String    @id @default(cuid())
  vendorId         String
  requestedPlanId  String
  mode             String // UPGRADE | DOWNGRADE
  note             String?
  status           String    @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedById    String?
  requestedByName  String?
  decidedById      String?
  decidedByName    String?
  decidedAt        DateTime?
  decisionNote     String?
  createdAt        DateTime  @default(now())

  @@unique([vendorId, id])
  @@index([vendorId, status])
  @@index([status, createdAt])
}

// ================= WAVE 4 (2026-10-08) — platform depth =================
// Four additive groups; every migration is 9_wave4_<letter>_… so the apply
// order (alphabetical) stays: wave2_* < wave3_* < wave4_a < _b < _c < _d.
// Plain String FK columns (no Prisma relations) per the H-10 convention.

// ---- Wave 4 WP-A — saved report templates + scheduled delivery ----------
model ReportTemplate {
  id             String    @id @default(cuid())
  vendorId       String
  reportKey      String
  name           String
  filtersJson    String    @default("{}")
  format         String    @default("XLSX") // XLSX | CSV
  schedule       String    @default("OFF") // OFF | DAILY | WEEKLY | MONTHLY
  recipientsJson String    @default("[]") // [{email, name?}]
  lastRunAt      DateTime?
  lastStatus     String? // SENT | FAILED | SKIPPED
  active         Boolean   @default(true)
  createdById    String?
  createdByName  String?
  createdAt      DateTime  @default(now())

  @@unique([vendorId, name])
  @@index([vendorId, active])
  @@index([vendorId, schedule])
}

model ReportDeliveryLog {
  id             String   @id @default(cuid())
  vendorId       String
  templateId     String
  templateName   String
  reportKey      String
  format         String
  status         String // SENT | FAILED | SKIPPED
  detail         String?
  recipientCount Int      @default(0)
  rows           Int?
  startedAt      DateTime @default(now())

  @@index([vendorId, startedAt])
  @@index([vendorId, templateId])
}

// ---- Wave 4 WP-B — accounting depth ------------------------------------
model AccountingPeriod {
  id            String    @id @default(cuid())
  vendorId      String
  name          String // FY2026-Q1, October 2026 …
  startDate     String
  endDate       String
  status        String    @default("OPEN") // OPEN | CLOSED
  closedById    String?
  closedByName  String?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())

  @@unique([vendorId, name])
  @@index([vendorId, startDate])
}

model CostCenter {
  id        String   @id @default(cuid())
  vendorId  String
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([vendorId, code])
}

model Budget {
  id             String   @id @default(cuid())
  vendorId       String
  periodId       String?
  costCenterId   String?
  accountCode    String
  amount         Float
  notes          String?
  createdById    String?
  createdByName  String?
  createdAt      DateTime @default(now())

  @@index([vendorId, periodId])
  @@index([vendorId, accountCode])
}

// ---- Wave 4 WP-C — public REST API + webhooks ---------------------------
model ApiKey {
  id             String    @id @default(cuid())
  vendorId       String
  name           String
  prefix         String // first 12 chars of the raw key, shown in UI
  hash           String // sha256(raw) hex — raw key is never stored
  scopesJson     String    @default("[]") // ["employees:read", …]
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdById    String?
  createdByName  String?
  createdAt      DateTime  @default(now())

  @@unique([vendorId, prefix])
  @@index([vendorId, revokedAt])
}

// ---- Phase 3 — Mobile/Desktop push device registry ----------------------
// One row per enrolled device (Expo/FCM/APNs). A user may have multiple
// devices. Tokens are refreshed by the mobile app on each launch and deleted
// on logout. The push route uses these to deliver notifications.
model DeviceToken {
  id          String    @id @default(cuid())
  vendorId    String
  userId      String
  // platform: "expo" (Expo Push) | "fcm" (Android FCM direct) | "apns" (iOS APNs direct)
  platform    String    @default("expo")
  // token: Expo push token ("ExponentPushToken[…]") or raw FCM/APNs token
  token       String
  deviceName  String?   // human-readable: "iPhone 15", "Pixel 8"
  appVersion  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, token])
  @@index([vendorId, userId])
  @@index([token])
}

model WebhookEndpoint {
  id             String    @id @default(cuid())
  vendorId       String
  url            String // https-only, SSRF-guarded on save
  eventsJson     String    @default("[]") // ["employee.created", …]
  secret         String? // encrypted at rest (crypto-field, M-36 pattern)
  active         Boolean   @default(true)
  description    String?
  lastStatus     String?
  lastDeliveredAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([vendorId, active])
}

model WebhookDelivery {
  id              String    @id @default(cuid())
  vendorId        String
  endpointId      String
  event           String
  payloadJson     String
  status          String    @default("PENDING") // PENDING | DELIVERED | FAILED
  responseStatus  Int?
  responseBody    String?
  attempts        Int       @default(0)
  nextAttemptAt   DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([vendorId, status])
  @@index([status, nextAttemptAt])
  @@index([vendorId, createdAt])
}

// ---- Wave 4 WP-D — recruitment ATS depth --------------------------------
model JobInterview {
  id              String   @id @default(cuid())
  vendorId        String
  applicationId   String
  round           String   @default("R1") // R1 | R2 | R3 | HR | FINAL
  mode            String   @default("ONSITE") // ONSITE | PHONE | VIDEO
  scheduledAt     String // ISO datetime
  durationMin     Int?
  interviewerId   String?
  interviewerName String?
  location        String?
  link            String?
  notes           String?
  outcome         String? // PENDING | PASSED | FAILED | CANCELLED
  score           Float?
  createdAt       DateTime @default(now())

  @@index([vendorId, applicationId])
  @@index([vendorId, scheduledAt])
}

model OfferLetter {
  id             String    @id @default(cuid())
  vendorId       String
  applicationId  String
  title          String
  grade          String?
  department     String?
  joiningDate    String?
  basicSalary    Float     @default(0)
  houseRent      Float     @default(0)
  medical        Float     @default(0)
  transport      Float     @default(0)
  otherAllowance Float     @default(0)
  notes          String?
  status         String    @default("DRAFT") // DRAFT | SENT | ACCEPTED | DECLINED
  sentAt         DateTime?
  decidedAt      DateTime?
  createdById    String?
  createdByName  String?
  createdAt      DateTime  @default(now())

  @@index([vendorId, applicationId])
  @@index([vendorId, status])
}

model OnboardingTask {
  id            String    @id @default(cuid())
  vendorId      String
  applicationId String?
  employeeId    String?
  title         String
  assigneeId    String?
  assigneeName  String?
  dueDate       String?
  doneAt        DateTime?
  doneById      String?
  doneByName    String?
  createdAt     DateTime  @default(now())

  @@index([vendorId, applicationId])
  @@index([vendorId, doneAt])
}

// ============================================================================
// Requirements round (2026-10-12) — platform-plane additions
// Plain String FK columns (no Prisma relations) per the H-10 convention for
// platform tables. Migration: 9_wave5_requirements_round_20261012.
// ============================================================================

// ---- R16 — login audit trail (success + failure, per attempt) ---------------
// Privacy-conscious: stores the ATTEMPTED email (needed to correlate brute
// force against known accounts), resolved identity when available, network
// metadata, and a derived browser/OS/device label. Retention is enforced by
// the daily jobs sweep (settings-driven, default 180 days).
model LoginAuditLog {
  id            String   @id @default(cuid())
  // plane: TENANT (app /api/hrm auth.login + auth.mfa.verify) | OWNER (/api/owner)
  plane         String   @default("TENANT") // TENANT | OWNER
  email         String // the address as typed (lowercased)
  success       Boolean  @default(false)
  failureReason String? // INVALID_CREDENTIALS | LOCKED_OUT | MFA_REQUIRED_FAILED | INACTIVE_VENDOR | RATE_LIMITED | ERROR
  userId        String?
  userName      String?
  vendorId      String?
  vendorName    String?
  role          String?
  mfaUsed       Boolean  @default(false)
  ip            String?
  userAgent     String? // raw User-Agent (truncated)
  browser       String? // derived label (Chrome 130, Firefox 131, Safari, Edge …)
  os            String? // derived label (Windows 11, macOS, Android 14, Linux …)
  deviceType    String? // desktop | mobile | tablet | bot | unknown
  createdAt     DateTime @default(now())

  @@index([vendorId, createdAt])
  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([success, createdAt])
  @@map("LoginAuditLog")
}

// ---- R11 — SaaS-owner marketing/promotional campaigns -----------------------
// Owner-plane mass communication to TENANT admins (not employees). Campaigns
// target tenant audiences, run through the platform gateway, and keep a full
// per-recipient delivery log with retry. Consent: Vendor.marketingOptOut.
model SaasCampaign {
  id             String    @id @default(cuid())
  name           String
  kind           String    @default("MARKETING") // MARKETING | PROMOTIONAL | CAMPAIGN | OFFER | NEWSLETTER
  channel        String    @default("EMAIL") // EMAIL | SMS
  subject        String? // EMAIL subject / SMS title (stored, not sent for SMS)
  body           String
  audienceType   String    @default("ALL") // ALL | ACTIVE | TRIAL | EXPIRED | PLAN | CUSTOM
  audienceIds    String    @default("[]") // JSON: plan ids (PLAN) or vendor ids (CUSTOM)
  status         String    @default("DRAFT") // DRAFT | SCHEDULED | SENDING | SENT | PARTIAL | FAILED
  scheduledFor   DateTime?
  sentAt         DateTime?
  totalRecipients Int      @default(0)
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  skippedCount   Int       @default(0) // opted-out / missing address / gateway unset
  templateId     String? // cloned source template (kept for provenance)
  createdById    String?
  createdByName  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  recipients SaasCampaignRecipient[]

  @@index([status, scheduledFor])
  @@index([createdAt])
  @@map("SaaSCampaign")
}

model SaasCampaignRecipient {
  id            String    @id @default(cuid())
  campaignId    String
  campaign      SaasCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  vendorId      String
  vendorName    String?
  contactEmail  String?
  contactPhone  String?
  status        String    @default("PENDING") // PENDING | SENT | FAILED | SKIPPED
  attempts      Int       @default(0)
  lastError     String? // gateway error detail (never credentials)
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([campaignId, vendorId])
  @@index([campaignId, status])
  @@map("SaaSCampaignRecipient")
}

// Reusable owner-plane message templates. Placeholders {{tenantName}},
// {{planName}}, {{endDate}}, {{platformName}}, {{offerCode}} are substituted
// at send time; unknown placeholders are left verbatim (never blanked).
model SaasCommunicationTemplate {
  id          String   @id @default(cuid())
  name        String
  kind        String   @default("MARKETING") // MARKETING | PROMOTIONAL | CAMPAIGN | OFFER | NEWSLETTER
  channel     String   @default("EMAIL") // EMAIL | SMS
  subject     String?
  body        String
  active      Boolean  @default(true)
  createdById   String?
  createdByName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind, active])
  @@map("SaasCommunicationTemplate")
}

// ---- R15 — subscription expiry notice log (pre/post expiry, email+SMS) ------
// One row per notice actually attempted (duplicate prevention is the
// @@unique key: vendor + kind + reference date + lead/lag days + channel).
// FAILED rows are retried by the next sweep run (attempts < 3).
model SaasExpiryNotice {
  id           String   @id @default(cuid())
  vendorId     String
  kind         String // PRE_EXPIRY | POST_EXPIRY | REJOIN_OFFER
  refDate      String // the endDate (or expiry date) the notice refers to, YYYY-MM-DD
  daysOffset   Int // days before (positive) / after (negative, or as configured) expiry
  channel      String // EMAIL | SMS
  status       String   @default("SENT") // PENDING | SENT | FAILED | SKIPPED
  attempts     Int      @default(1)
  detail       String? // delivery detail (gateway status; never credentials)
  sentAt       DateTime @default(now())

  @@unique([vendorId, kind, refDate, daysOffset, channel])
  @@index([vendorId, sentAt])
  @@index([status, sentAt])
  @@map("SaasExpiryNotice")
}

// ============================================================================
// Wave 10 — INFRASTRUCTURE ROUND (2026-10-24) — support access, payments
// depth (Paystation/EPS), cloud object storage, SMS journal + OTP.
// Migration 9_wave9zp_infra_support_payments_storage_sms_20261024.
// Status columns are string unions by schema convention (NO Prisma enums).
// ============================================================================

// ---- Phase 2 — Time-Limited Support Access (owner → tenant plane) -----------
// A THIRD session plane (own cookie `saas_support_session`, own table, own
// CSRF token): a tenant token can never authorize an owner action and an
// owner token can never open a tenant workspace — the one-time 60-second
// enter capability minted by owner.supportAccess.start is the ONLY bridge.
// Only the sha256 hash of every token is stored (enterTokenHash /
// sessionTokenHash — same discipline as Session.tokenHash).
model SaasSupportAccessSession {
  id              String    @id @default(cuid())
  targetVendorId  String
  targetVendorName String
  operatorOwnerId String
  operatorName    String
  operatorRoleKey String
  reason          String
  ticketRef       String?
  // 2026-10-25 — origin tenant-submitted Live Support Access request (master
  // prompt Part B §4.1). Null for owner-initiated sessions (legacy path).
  liveRequestId   String?   @unique
  // approved module scope for tenant-initiated sessions (JSON array of module
  // keys from the approved SaasLiveSupportRequest; null/[] = owner-defined)
  approvedModulesJson String @default("[]")
  accessMode      String    @default("READ_ONLY") // READ_ONLY | CONTROLLED_WRITE
  scopeJson       String    @default("[]") // controlled-write module.action allowlist
  status          String    @default("PENDING") // PENDING | ACTIVE | ENDED | EXPIRED | REVOKED
  enterTokenHash  String?   @unique // one-time 60s enter capability (burned on use)
  enterExpiresAt  DateTime?
  sessionTokenHash String?  @unique // live session cookie token hash (null when ended)
  csrfToken       String?
  requestedMinutes Int      @default(15)
  startedAt       DateTime?
  expiresAt       DateTime?
  lastSeenAt      DateTime?
  endedAt         DateTime?
  endedReason     String?
  endedById       String?
  endedByName     String?
  ip              String?
  userAgent       String?
  createdAt       DateTime  @default(now())

  @@index([targetVendorId, createdAt])
  @@index([operatorOwnerId, createdAt])
  @@index([status, expiresAt])
  @@map("SaasSupportAccessSession")
}

// ---- 2026-10-25 — Support Center: tenant↔platform tickets + chat ----------
// (master prompt Part A §3.1). Tenant-plane conversations with authorized
// support personnel. vendorId is a plain string (SaaS-plane convention — see
// SaasSupportAccessSession: no FK to Vendor, H-10 scoping enforced in routes).
model SaasSupportTicket {
  id              String    @id @default(cuid())
  vendorId        String
  number          String    @unique // TKT-2026-000123
  subject         String
  category        String    @default("GENERAL") // GENERAL | BILLING | ATTENDANCE | PAYROLL | LEAVE | EMPLOYEES | RECRUITMENT | REPORTS | SECURITY | DATA | INTEGRATION | OTHER
  priority        String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  // OPEN | ASSIGNED | IN_PROGRESS | WAITING_TENANT | WAITING_SUPPORT | RESOLVED | CLOSED
  status          String    @default("OPEN")
  requesterUserId String
  requesterName   String
  assigneeOwnerId String?
  assigneeName    String?
  firstResponseAt DateTime?
  lastMessageAt   DateTime?
  closedAt        DateTime?
  closedByName    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  messages SaasSupportMessage[]

  @@index([vendorId, status, updatedAt])
  @@index([status, priority, createdAt])
  @@index([assigneeOwnerId])
  @@map("SaasSupportTicket")
}

// One chat message inside a ticket. authorRole: TENANT (the requester or a
// colleague with support.view) | SUPPORT (an owner-console operator).
// Attachments ride the platform storage layer: attachmentsJson is a JSON
// array of {objectKey, fileName, mimeType, sizeBytes, uploadedBy} referencing
// StorageObject rows (storeUpload kind SUPPORT_ATTACHMENT) — signed URLs are
// issued on read, never persisted.
model SaasSupportMessage {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      SaasSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorRole  String // TENANT | SUPPORT
  authorId    String // user id (tenant plane) or owner user id
  authorName  String
  body        String   @db.Text
  attachmentsJson String @default("[]")
  internalNote Boolean @default(false) // support-side note, never shown to the tenant
  readByTenantAt  DateTime?
  readBySupportAt DateTime?
  createdAt   DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("SaasSupportMessage")
}

// ---- 2026-10-25 — Live Support Access REQUESTS (master prompt Part A §3.2,
// Part B §4). A tenant-submitted request is NOT a session: review → approve
// (modules + duration + agent) → activate (one-time link) are distinct,
// audited operations. Approval creates a PENDING SaasSupportAccessSession
// linked by liveRequestId.
model SaasLiveSupportRequest {
  id                String   @id @default(cuid())
  vendorId          String
  ticketId          String? // optional originating ticket
  title             String
  description       String   @db.Text
  category          String   @default("GENERAL")
  // requested module keys — validated against TENANT_MODULES + entitlements
  modulesJson       String   @default("[]")
  priority          String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  contextNote       String?  @db.Text // tenant-provided additional context
  // PENDING_REVIEW | APPROVED | REJECTED | ACTIVE | COMPLETED | REVOKED | EXPIRED | CANCELLED
  status            String   @default("PENDING_REVIEW")
  requestedByUserId String
  requestedByName   String
  reviewedByOwnerId String?
  reviewedByName   String?
  reviewNote       String?   @db.Text // rejection reason / clarification / approval terms
  approvedModulesJson String? // modules actually approved (subset of request)
  approvedMinutes   Int?
  approvedAgentOwnerId String?
  approvedAgentName   String?
  activatedSessionId String? // the SaasSupportAccessSession created on activation
  requestedAt       DateTime @default(now())
  reviewedAt        DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([vendorId, status, createdAt])
  @@index([status, priority, createdAt])
  @@map("SaasLiveSupportRequest")
}

// ---- 2026-10-25 — WebAuthn / passkey credentials (master prompt Part K §16) --
// TWO planes, ONE table: plane="TENANT" → userId is a tenant User id (with
// vendorId); plane="OWNER" → userId is a SaasOwnerUser id (vendorId null).
// ONLY public-key material is stored — the browser/OS handles biometrics;
// raw biometric data never reaches the server.
model WebAuthnCredential {
  id            String   @id @default(cuid())
  plane         String // TENANT | OWNER
  userId        String
  vendorId      String?
  credentialId  String   @unique // base64url of the authenticator credential id
  publicKey     String   @db.Text // COSE pubkey, base64url
  counter       BigInt   @default(0)
  transports    String?  // JSON array: ["internal","hybrid","cross-platform",…]
  deviceName    String   @default("Passkey")
  backupEligible Boolean @default(false)
  backupState   Boolean @default(false)
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())

  @@unique([plane, userId, credentialId])
  @@index([plane, userId])
  @@map("WebAuthnCredential")
}

// Single-use WebAuthn challenges (registration + authentication), 120s TTL,
// burned on use — replay-safe.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  plane     String // TENANT | OWNER
  userId    String?
  challenge String // base64url, single-use
  type      String // REGISTRATION | AUTHENTICATION
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([plane, userId, expiresAt])
  @@map("WebAuthnChallenge")
}

// ---- Phase 6 — SMS delivery journal (BOTH planes) ----------------------------
// Every outbound submission is journaled for reconciliation, cost accounting
// and abuse forensics. OTP rows store the body LENGTH only — the code itself
// never touches this table. vendorId is null on the PLATFORM plane.
model SaasSmsMessage {
  id                String    @id @default(cuid())
  plane             String    @default("TENANT") // TENANT | PLATFORM
  vendorId          String?
  toPhone           String // normalized +880…
  purpose           String // OTP_LOGIN | OTP_VERIFY | TEST | WISHES | NOTICE | CAMPAIGN | SYSTEM
  templateKey       String?
  bodyLength        Int       @default(0)
  bodyPreview       String? // null for OTP purposes (never stored)
  provider          String // sslwireless | generichttp | …
  providerMessageId String?
  status            String    @default("PENDING") // PENDING | SENT | FAILED | SKIPPED
  statusDetail      String?
  attempts          Int       @default(0)
  lastAttemptAt     DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime  @default(now())
  // matches migration 9_wave9zp exactly: NOT NULL, NO DB default — the
  // Prisma client maintains this column via @updatedAt.
  updatedAt         DateTime  @updatedAt

  @@index([vendorId, createdAt])
  @@index([plane, status, createdAt])
  @@index([provider, providerMessageId])
  @@map("SaasSmsMessage")
}

// ---- Phase 6 — OTP verifiers (SMS second factor / verification codes) -------
// The code is stored ONLY as sha256(code + salt); attempts are capped per
// issue; consumption is single-use. vendorId scopes tenant-plane verifications.
model SaasOtpCode {
  id         String    @id @default(cuid())
  identifier String // phone (normalized) or email (lowercased)
  channel    String    @default("SMS") // SMS | EMAIL
  purpose    String // e.g. LOGIN_2FA | SUPPORT_ENTER | PHONE_VERIFY
  codeHash   String // sha256(code + salt)
  salt       String
  expiresAt  DateTime
  attempts   Int       @default(0)
  maxAttempts Int      @default(5)
  consumedAt DateTime?
  vendorId   String?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([identifier, purpose, createdAt])
  @@index([expiresAt])
  @@map("SaasOtpCode")
}

// ---- Phase 4 — cloud object storage metadata ---------------------------------
// One row per object handed to the storage abstraction (avatars, employee
// documents, CMS media). objectKey is globally unique and provider-prefixed;
// the payload itself lives in the configured bucket (Cloudflare R2 /
// Cloudinary) — the DB keeps only metadata + the public/signed URL is derived
// from objectKey per provider. status FAILED + lastError record upload
// failures for the console's retry surface.
model StorageObject {
  id        String   @id @default(cuid())
  vendorId  String
  kind      String // AVATAR | EMPLOYEE_DOC | CMS_MEDIA | LETTER_PDF | EXPORT
  objectKey String   @unique // provider-prefixed key inside the bucket
  provider  String // r2 | cloudinary | local
  mimeType  String
  sizeBytes BigInt
  sha256    String?
  status    String   @default("STORED") // STORED | FAILED
  refTable  String? // logical owner table name (audit provenance)
  refId     String? // logical owner row id
  lastError String?
  createdAt DateTime @default(now())
  // matches migration 9_wave9zp exactly: NOT NULL, NO DB default — the
  // Prisma client maintains this column via @updatedAt.
  updatedAt DateTime @updatedAt

  @@index([vendorId, kind])
  @@index([status])
  @@map("StorageObject")
}

// ---- Wave 11 §4 — transactional outbox ---------------------------------------
// Durable side-effect queue written INSIDE the same database transaction as
// the state change that caused them (2026-10-26 scalability round, master
// prompt §4: "No lost critical work between database transactions and job
// enqueueing"). Settlement today flips payment+invoice in one $transaction;
// the receipt email + invoice.paid webhook used to be fire-and-forget calls
// AFTER the commit — a crash between the two silently lost the tenant's
// receipt. They now land here atomically and a relay (tick + opportunistic
// post-commit flush) delivers them with bounded exponential-backoff retries
// and a FAILED dead-letter state surfaced through /api/metrics.
//
// Delivery semantics: at-least-once — every handler is idempotent (the
// receipt re-reads the PAID invoice; webhookEmit journals per delivery).
// Claiming uses UPDATE … WHERE id IN (SELECT … FOR UPDATE SKIP LOCKED) so
// N app instances can relay concurrently without double-claiming (§2/§4).
model OutboxEvent {
  id            String    @id @default(cuid())
  type          String // invoice.paid.receipt | invoice.paid.webhook | …
  vendorId      String? // tenant scoping (platform-wide events may be null)
  payloadJson   String    @default("{}")
  status        String    @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  @@index([status, nextAttemptAt, createdAt]) // the SKIP LOCKED claim scan
  @@index([type, vendorId])
  @@map("OutboxEvent")
}
