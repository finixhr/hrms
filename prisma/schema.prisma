// HRM P2 & Commission Rule Setup — comprehensive commission rule engine (Payroll → Bonuses & Commission)
model CommissionRule {
  id                    String    @id @default(cuid())
  vendorId              String
  name                  String
  calculationPeriod     String    @default("MONTHLY") // MONTHLY | QUARTERLY | HALF_YEARLY | YEARLY
  effectiveFrom         DateTime  @default(now())
  effectiveTo           DateTime? // null = open-ended
  active                Boolean   @default(true)
  status                String    @default("ACTIVE") // DRAFT | PENDING_APPROVAL | ACTIVE | INACTIVE | REJECTED

  // Calculation Basis & Method
  basis                 String    @default("PERCENT_OF_SALES") // PERCENT_OF_SALES | FLAT
  percentMethod         String?   // TOTAL_REVENUE | REVENUE_EXCEEDING_TARGET
  flatMethod            String?   // PER_EMPLOYEE | TOTAL_POOL
  rate                  Float     @default(0) // % of sales (0-100) or flat amount in BDT
  distributionMethod    String?   // EQUAL | SALARY_PRO_RATA

  // Eligibility Criteria & Target Flags
  minServicePeriodValue Int       @default(0)
  minServicePeriodUnit  String    @default("MONTHS") // DAYS | MONTHS | YEARS
  requireTotalTarget    Boolean   @default(false)
  requireBranchTarget   Boolean   @default(false)
  requireDeptTarget     Boolean   @default(false)
  requireEmpTarget      Boolean   @default(false)

  // Cap
  cap                   Float     @default(0) // Total rule commission cap (0 = uncapped)

  // Eligible Employee Statuses (JSON string[] — default covers active workforce)
  eligibleStatuses      String    @default("[\"ACTIVE\",\"PROBATION\"]") // JSON array of Employee.status values

  // Scope (optional overrides)
  branchId              String?   // null = all branches
  departmentId          String?   // null = all departments
  designationId         String?   // null = all designations
  minSales              Float     @default(0) // backward-compatible legacy minimum sales

  // Audit & Workflow
  approvalRequestId     String?
  createdBy             String?
  approvedBy            String?
  version               Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  thresholds            CommissionThreshold[]
  thresholdImports      CommissionThresholdImport[]

  @@index([vendorId])
  @@index([vendorId, active])
  @@index([vendorId, calculationPeriod])
}

model CommissionThreshold {
  id            String    @id @default(cuid())
  vendorId      String
  ruleId        String
  targetType    String    // TOTAL | BRANCH | DEPARTMENT | EMPLOYEE
  targetId      String?   // null for TOTAL, branchId for BRANCH, departmentId for DEPT, employeeId for EMP
  targetName    String?   // Denormalized name for display / audit
  thresholdAmount Float   @default(0) // Minimum target revenue in BDT
  status        String    @default("APPROVED") // APPROVED | PENDING_APPROVAL | REJECTED
  importId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  rule          CommissionRule             @relation(fields: [ruleId], references: [id], onDelete: Cascade)
