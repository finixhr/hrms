// ============================ HR LETTERS ============================

model LetterTemplate {
  id                   String   @id @default(cuid())
  vendorId             String
  type                 String // APPOINTMENT | CONFIRMATION | PROBATION_EXT | SALARY_CERT | EMPLOYMENT_CERT | EXPERIENCE | INCREMENT | PROMOTION | TRANSFER | WARNING | APPRECIATION | SHOW_CAUSE | SUSPENSION | TERMINATION | RESIGN_ACCEPT | RELEASE | RELIEVING | NOC | CUSTOM
  name                 String
  subject              String
  body                 String // with {{variables}}
  signatoryName        String?
  signatoryDesignation String?
  requiresApproval     Boolean  @default(true)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([vendorId, type])
}

model HrLetter {
  id                String    @id @default(cuid())
  vendorId          String
  employeeId        String
  type              String
  templateId        String?
  letterNumber      String
  subject           String
  content           String // rendered snapshot
  signatoryName     String?
  status            String    @default("DRAFT") // DRAFT | PREPARED | HR_REVIEW | MANAGEMENT_APPROVAL | APPROVED | ISSUED | REJECTED
  issuedAt          DateTime?
  approvedBy        String? // user who gave the final approval (spec §13.5 issuance history)
  deliveryMethod    String? // PORTAL | EMAIL | PRINT
  // LTR-02 (R7) — anti-forgery verification code (HMAC-derived at issue,
