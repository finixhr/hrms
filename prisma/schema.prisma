// ============================ RESIGNATION & EXIT ============================

model Resignation {
  id                String    @id @default(cuid())
  vendorId          String
  employeeId        String
  submissionDate    String
  resignationDate   String
  proposedLwd       String
  actualLwd         String?
  reason            String
  remarks           String?
  letterName        String?
  letterData        String?
  status            String    @default("SUBMITTED") // DRAFT | SUBMITTED | UNDER_REVIEW | MANAGER_APPROVED | HR_REVIEW | MANAGEMENT_REVIEW | ACCEPTED | REJECTED | WITHDRAWN | NOTICE_PERIOD | COMPLETED
  acceptedAt        DateTime?
  withdrawnAt       DateTime?
  withdrawStage     String?
  noticeMode        String    @default("FULL") // FULL | SHORT | WAIVED | BUYOUT | EARLY_RELEASE
  noticeDays        Int       @default(30)
  servedDays        Int       @default(0)
  approvalRequestId String?
  actedBy           String?
  actedAt           DateTime?
  // HRM-018 — access/status closure workflow on exit
  closureStatus     String    @default("PENDING") // PENDING | SCHEDULED | DONE
  closureDoneAt     DateTime?
  createdAt         DateTime  @default(now())

  @@index([vendorId, status])
  @@index([vendorId, employeeId])
