// Finix HR — Complete domain schema
// Multi-tenant: nearly every model carries vendorId. Historical records are
// append-only (EmployeeHistory, SalaryRevision, Promotion, Transfer, paid payroll).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================ FOUNDATION ============================

model Vendor {
  id                   String   @id @default(cuid())
  name                 String
  code                 String   @unique
  legalName            String?
  logoUrl              String?
  address              String?
  phone                String?
  email                String?
  // authorized letter signatory (spec §13.5)
  signatoryName        String?
  signatoryDesignation String?
  signatureUrl         String? // data URL (client-resized) or http URL
  sealUrl              String? // company seal / round stamp image
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  // R11 (2026-10-12) — SaaS-owner marketing consent: a tenant may opt out of
  // platform marketing/promotional/campaign emails & SMS. Owner-plane
  // campaign sends exclude opted-out vendors; transactional notices
  // (invoices, expiry reminders, application status) are NEVER affected.
  marketingOptOut      Boolean  @default(false)
  // SaaS platform back-relation (platform plane — see SaaS* block at the
  // bottom of this file; the tenant HRM code never queries it)
  saasSubscriptions    SaasSubscription[]
}

model User {
  id                       String    @id @default(cuid())
  vendorId                 String
  employeeId               String?
  email                    String
  passwordHash             String
  name                     String
  phone                    String?
  role                     String // HR_ADMIN | HR_MANAGER | PAYROLL_OFFICER | BRANCH_MANAGER | DEPT_MANAGER | EMPLOYEE | VENDOR_OWNER
  permissions              String    @default("[]") // JSON array of "module.action" grants; [] = derive from role template
  branchId                 String? // scope limit
  departmentId             String? // scope limit
  status                   String    @default("ACTIVE") // ACTIVE | SUSPENDED | DISABLED
  lastLoginAt              DateTime?
  failedLoginCount         Int       @default(0)
  lockedUntil              DateTime?
  passwordChangedAt        DateTime?
  // First-login forced password rotation: set true when an account is created
  // (employee self-service onboarding / admin password reset) with a temporary
  // password. Login then routes through the forced change step and the flag is
  // cleared by changePassword(). Independent of the 90-day expiry policy so it
  // works even when password expiry is disabled.
  mustChangePassword       Boolean   @default(false)
  passwordHistory          String    @default("[]") // JSON array of previous hashes (policy reuse check)
  mfaEnrolled              Boolean   @default(false)
  // 2026-10-25 design systems (master prompt Part L): per-user platform design
  // preference ("comet" | "cursor-1" | "cursor-2"); null = follow tenant +
  // platform defaults. Applied by the pre-paint script + app shell.
  designPreference         String?
  passwordResetToken       String? // sha-256 of the emailed reset code
  passwordResetExpiresAt   DateTime?
  passwordResetRequestedAt DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  sessions                 Session[]

  @@unique([vendorId, email])
  @@index([email]) // M-15 — login lookup: no full-table scan on the hot path
  @@index([vendorId])
}

model Session {
  id         String   @id
  // SEC-02 (R5) — session tokens are hashed at rest, exactly like API keys and
  // refresh tokens always were. New rows: id is a random ROW id (never the
  // credential) + tokenHash = sha256(cookie token); lookups go through the
  // hash. Migration 9_wave9zm backfilled tokenHash on legacy rows (their id
  // stays the legacy plaintext until they expire — the rotation window).
  tokenHash  String?  @unique
  userId     String
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now()) // idle-timeout policy (Settings → Session Policy)
  // C-4/H-13 hardening: session kind (PREAUTH = MFA/expiry challenge carrier, carries no app
  // rights) + per-session CSRF token (echoed by the SPA in X-CSRF-Token on every mutating RPC).
  kind       String   @default("FULL") // FULL | PREAUTH
  csrfToken  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // SCL-19 (Phase 2 WS5) — the daily expired-session purge deletes on
  // expiresAt; without this index the purge seq-scanned the whole table.
  @@index([expiresAt])
}

// TOTP enrolment secrets + hashed recovery codes (HRM-006 MFA / 2FA)
model UserMfaSecret {
  id                String   @id @default(cuid())
  vendorId          String
  userId            String   @unique
  secretEnc         String // encrypted TOTP shared secret
  recoveryCodesHash String   @default("[]") // JSON array of sha256 hashes
  lastUsedCounter   Int? // M-16 — TOTP replay protection: highest accepted HMAC counter
  enrolledAt        DateTime @default(now())

  @@index([vendorId])
}

model Role {
  id          String  @id @default(cuid())
  vendorId    String
  key         String // HR_ADMIN ...
  name        String
  description String?
  permissions String  @default("[]") // JSON string[]
  isSystem    Boolean @default(false)
  mfaRequired Boolean @default(false) // HRM-006: force TOTP for users in this role

  @@unique([vendorId, key])
}

model AuditLog {
  id        String   @id @default(cuid())
  vendorId  String
  userId    String?
  userName  String?
  action    String // e.g. employees.update
  entity    String
  entityId  String?
  summary   String
  oldValue  String?
  newValue  String?
  ip        String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([vendorId, createdAt])
  @@index([vendorId, entity])
}

model Notification {
  id         String    @id @default(cuid())
  vendorId   String
  userId     String? // null = broadcast to vendor users matched by role
  employeeId String?
  title      String
  message    String
  type       String // LEAVE | PAYROLL | ATTENDANCE | TASK | LOAN | EXPENSE | DOC | LETTER | WISH | SYSTEM | ANNOUNCEMENT | EXIT | KP
  link       String? // nav target
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([vendorId, userId])
  @@index([vendorId, employeeId])
}

model CompanyEvent {
  id          String   @id @default(cuid())
  vendorId    String
  title       String
  type        String // MEETING | EVENT | HR_EVENT | PAYROLL_TASK
  date        String // ISO date
  time        String?
  description String?
  branchId    String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([vendorId, date])
}

// ============================ APPROVAL WORKFLOW ENGINE ============================

model ApprovalWorkflow {
  id          String   @id @default(cuid())
  vendorId    String
  name        String
  processType String // LEAVE | LOAN | EXPENSE | PAYROLL | LETTER | RESIGNATION | ADVANCE | PROMOTION | TRANSFER | SALARY_REVISION | OVERTIME | ENCASHMENT | GOODS_REQUISITION | PURCHASE | ASSET_ISSUE
  active      Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())

  @@unique([vendorId, processType])
}

model ApprovalStep {
  id              String  @id @default(cuid())
  // DB-02 (R5) — child tables carry their tenant explicitly (backfilled from ApprovalWorkflow).
  vendorId String
  workflowId      String
  sequence        Int
  name            String
  approverRole    String? // role key that can act
  approverUserId  String? // specific approver
  departmentScope Boolean @default(false) // route to employee's dept manager
  branchScope     Boolean @default(false) // route to employee's branch manager
  amountThreshold Float?
  required        Boolean @default(true)
  allowDelegation Boolean @default(false)
  rejectBehavior  String  @default("REJECT_ALL") // REJECT_ALL | RETURN_TO_PREVIOUS

  @@unique([vendorId, workflowId, sequence])
  @@index([vendorId, workflowId])
}

model ApprovalRequest {
  id          String    @id @default(cuid())
  vendorId    String
  workflowId  String
  processType String
  entityType  String // LeaveRequest | Loan | ...
  entityId    String
  entityRef   String? // human reference (employee name etc.)
  requestedBy String
  currentStep Int       @default(1)
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED | WITHDRAWN
  payloadJson String    @default("{}")
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([vendorId, status])
  @@index([vendorId, processType])
}

model ApprovalAction {
  id        String   @id @default(cuid())
  // DB-02 (R5) — child tables carry their tenant explicitly (backfilled from ApprovalRequest).
  vendorId String
  requestId String
  step      Int
  userId    String? // null = system AUTO action (H-4 threshold auto-skip)
  userName  String
  action    String // APPROVE | REJECT | SKIP
  comment   String?
  createdAt DateTime @default(now())

  @@index([vendorId, requestId])
}

// ============================ SETTINGS & CALENDAR ============================

model HrSetting {
  id        String   @id @default(cuid())
  vendorId  String
  group     String // general | attendance | geofence | leave | payroll | ait | shift | notification | wishes
  key       String
  value     String // JSON
  updatedAt DateTime @updatedAt

  @@unique([vendorId, group, key])
}

model Holiday {
  id        String   @id @default(cuid())
  vendorId  String
  branchId  String? // null = all branches
  name      String
  date      String // ISO date
  type      String   @default("PUBLIC") // PUBLIC | OPTIONAL | COMPANY
  createdAt DateTime @default(now())

  @@index([vendorId, date])
}

// ============================ ORGANIZATION ============================

model Branch {
  id                String     @id @default(cuid())
  vendorId          String
  code              String
  name              String
  type              String     @default("STORE") // STORE | OFFICE | WAREHOUSE | OTHER
  address           String?
  managerId         String? // employee id
  contact           String?
  operatingHours    String?
  latitude          Float?
  longitude         Float?
  geofenceRadius    Float? // meters
  geofenceActive    Boolean    @default(false)
  geofenceStartTime String? // fence-local attendance window start (spec §7.5)
  geofenceEndTime   String? // fence-local attendance window end (spec §7.5)
  active            Boolean    @default(true)
  employees         Employee[] @relation("EmployeeBranch") // H-10 back-relation
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([vendorId, code])
  @@index([vendorId])
}

model Department {
  id          String     @id @default(cuid())
  vendorId    String
  code        String
  name        String
  nameBn      String?
  description String?
  branchId    String?
  headId      String? // employee id
  employees   Employee[] @relation("EmployeeDepartment")
  status      String     @default("ACTIVE")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([vendorId, code])
  @@index([vendorId])
}

model Designation {
  id           String     @id @default(cuid())
  vendorId     String
  code         String
  name         String
  nameBn       String?
  employees    Employee[] @relation("EmployeeDesignation")
  departmentId String?
  grade        String?
  minSalary    Float?
  maxSalary    Float?
  description  String?
  status       String     @default("ACTIVE")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([vendorId, code])
  @@index([vendorId])
}

// ============================ SHIFT ENGINE ============================

model Shift {
  id                    String   @id @default(cuid())
  vendorId              String
  name                  String
  type                  String   @default("FIXED") // FIXED | ROTATIONAL
  startTime             String // HH:MM
  endTime               String // HH:MM
  graceMinutes          Int      @default(10)
  breakMinutes          Int      @default(60)
  minWorkingHours       Float    @default(8)
  otThresholdMinutes    Int      @default(30) // minutes beyond shift end eligible for OT
  otMultiplier          Float    @default(1.5) // weekday OT rate
  otHolidayMultiplier   Float    @default(2.0) // government-holiday OT rate (spec §7.6)
  otWeeklyOffMultiplier Float    @default(2.0) // weekly-off OT rate (spec §7.6)
  weeklyOff             String   @default("FRIDAY") // comma list
  branchId              String? // null = all branches
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([vendorId])
}

model ShiftAssignment {
  id         String   @id @default(cuid())
  vendorId   String
  employeeId String
  shiftId    String
  fromDate   String
  toDate     String?
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([vendorId, employeeId])
  @@index([vendorId, fromDate])
}

// ============================ EMPLOYEE MASTER ============================

model Employee {
  id                     String       @id @default(cuid())
  vendorId               String
  code                   String // EMP-0001
  // MOD-17 (Phase 2 WS4) — pg_trgm GIN indexes on fullName + code live in
  // migration 9_wave9zf (Prisma has no native trigram declaration); they serve
  // the directory/picker ILIKE searches.
  photoUrl               String?
  // 96×96 list thumbnail (data URL) generated client-side together with
  // photoUrl — directory rows / org-chart nodes ship the thumb instead of
  // the 512×512 photoUrl so employees.list payloads stay small. Falls back
  // to photoUrl for photos uploaded before this column existed.
  photoThumb             String?
  fullName               String
  nameBn                 String?
  preferredName          String?
  fatherName             String?
  motherName             String?
  spouseName             String?
  dob                    String? // ISO
  placeOfBirth           String?
  gender                 String?
  bloodGroup             String?
  maritalStatus          String?
  nationality            String       @default("Bangladeshi")
  religion               String?
  mobile                 String?
  altMobile              String?
  personalEmail          String?
  officialEmail          String?
  emergencyName          String?
  emergencyRelation      String?
  emergencyMobile        String?
  presentAddress         String?
  permanentAddress       String?
  division               String?
  district               String?
  city                   String?
  postCode               String?
  presentDivision        String?
  presentDistrict        String?
  presentCity            String?
  presentPostCode        String?
  addressSame            Boolean      @default(false)
  // employment
  branchId               String?
  departmentId           String?
  designationId          String?
  reportingManagerId     String?
  hrManagerId            String?
  supervisorId           String?
  // H-10 — referential integrity: org anchors are Restrict (an employee row
  // pins its branch/department/designation; deleting the org node must be
  // blocked while employees reference it).
  branch                 Branch?      @relation("EmployeeBranch", fields: [branchId], references: [id], onDelete: Restrict)
  department             Department?  @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  designation            Designation? @relation("EmployeeDesignation", fields: [designationId], references: [id], onDelete: Restrict)
  workLocation           String?
  joiningDate            String?
  confirmationDate       String?
  probationMonths        Int          @default(3)
  // EXT-05 (R7) — rehire linkage: a rehired employee points at their prior
  // Employee row so service history (and statutory gratuity continuity
  // decisions) stays reachable. Cleared/derived fields never copy over.
  priorEmployeeId        String?
  employmentType         String       @default("PERMANENT") // PERMANENT | PROBATIONARY | CONTRACTUAL | TEMPORARY | PART_TIME | INTERN | COMMISSION | FREELANCE
  status                 String       @default("ACTIVE") // ACTIVE | PROBATION | ON_LEAVE | SUSPENDED | RESIGNED | TERMINATED | RETIRED | INACTIVE
  category               String?
  grade                  String?
  shiftId                String?
  weeklyOff              String?
  contractStart          String?
  contractEnd            String?
  otEligible             Boolean      @default(true) // overtime eligibility (spec §7.6)
  previousEmployerIncome Float        @default(0) // current-FY income from previous employer (spec §9.5)
  taxAlreadyDeducted     Float        @default(0) // tax already deducted this FY (spec §9.5)
  // Salary payout method (2026-10 round §42–§46): BANK | CASH | MFS. NULL =
  // not yet configured (legacy employees) — the payout resolver treats NULL
  // as CASH for validation only when the salary is within the cash/MFS
  // threshold, and blocks payment until configured above it.
  salaryPayoutMethod     String?
  salaryPayoutAccountId  String? // designated BankAccount.id (BANK/MFS methods)
  // ---- AIT (Income Tax Act 2023) per-employee tax profile ----
  taxTin                 String? // 12-digit e-TIN
  taxCategory            String? // general | female | senior | disabled | third_gender | freedom_fighter | july_warrior | non_resident
  declaredInvestment     Float? // declared investment for Sec 78 rebate (AY-current)
  festivalBonusOverride  Float? // explicit bonus count (× monthly basic) for annual projection
  annualGrossOverride    Float? // explicit annual gross — bypasses projection entirely
  // ---- r8 audit (2026-10-14): surcharge inputs (FO 2025 / FA 2026 net-wealth bands) ----
  taxNetWealth           Float? // declared net worth — surcharge band test; null = not assessed (warns)
  taxMotorVehicles       Int     @default(0) // motor cars owned — >1 triggers the 10% surcharge band
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  // H-10 — back-relations from money/history tables (Restrict everywhere:
  // employees with payroll/leave/loan history cannot be hard-deleted via the
  // DB layer; the app enforces archive-first semantics)
  leaveRequests  LeaveRequest[]
  loans          Loan[]
  payrollEntries PayrollEntry[]

  @@unique([vendorId, code])
  @@unique([vendorId, id]) // H-10 — structural tenant scoping for joins
  @@index([vendorId, status])
  @@index([vendorId, branchId])
  @@index([vendorId, departmentId])

  // M-6 — identity backing for the app-level dedup (bulk import + create both
  // check these); partial in effect: NULL mobile/officialEmail rows are exempt
  // (PostgreSQL treats NULLs as distinct). Deploying the migration against data
  // that ALREADY has duplicates fails loudly — run
  // scripts/check-employee-identity-uniques.ts first.
  @@unique([vendorId, officialEmail])
  @@unique([vendorId, mobile])
  @@index([vendorId, priorEmployeeId])
}

model FamilyMember {
  id           String  @id @default(cuid())
  // DB-02 (R5) — child tables carry their tenant explicitly (backfilled from Employee).
  vendorId String
  employeeId   String
  name         String
  relationship String
  dob          String?
  gender       String?
  occupation   String?
  mobile       String?
  email        String?
  address      String?
  dependent    Boolean @default(false)
  notes        String?

  @@index([vendorId, employeeId])
}

model Education {
  id              String  @id @default(cuid())
  // DB-02 (R5) — child tables carry their tenant explicitly (backfilled from Employee).
  vendorId String
  employeeId      String
  degree          String
  examination     String?
  institution     String?
  board           String?
  major           String?
  passingYear     String?
  result          String?
  certificateName String? // certificate attachment (spec §5.4)
  certificateData String? // data URL payload
  notes           String?

  @@index([vendorId, employeeId])
}

model Referee {
  id                 String    @id @default(cuid())
  // DB-02 (R5) — child tables carry their tenant explicitly (backfilled from Employee).
  vendorId String
  employeeId         String
  name               String
  relationship       String?
  organization       String?
  designation        String?
  mobile             String?
  email              String?
  address            String?
  knownFor           String?
  type               String    @default("PROFESSIONAL") // PROFESSIONAL | PERSONAL | PREVIOUS_EMPLOYER | GUARDIAN | OTHER
  notes              String?
  verificationStatus String    @default("PENDING") // PENDING | VERIFIED | FAILED
  verifiedAt         DateTime?
  verifiedBy         String?

  @@index([vendorId, employeeId])
}

model PreviousEmployment {
  id               String  @id @default(cuid())
  // DB-02 (R5) — child tables carry their tenant explicitly (backfilled from Employee).
  vendorId String
  employeeId       String
  company          String
  designation      String?
  department       String?
  joinDate         String?
  leaveDate        String?
  lastSalary       Float?
  reasonForLeaving String?
  supervisor       String?
  contact          String?
  notes            String?

  @@index([vendorId, employeeId])
}

model BankAccount {
  id                    String  @id @default(cuid())
  // DB-02 (R5) — child tables carry their tenant explicitly (backfilled from Employee).
  vendorId String
  employeeId            String
  holderName            String?
  bank                  String?
  branch                String?
  accountNumber         String?
  routingNumber         String?
  accountType           String  @default("SALARY") // SAVINGS | CURRENT | SALARY
  mfsProvider           String? // BKASH | NAGAD | ROCKET | OTHER
  mfsNumber             String?
  paymentMethod         String  @default("BANK") // BANK | MFS | CASH | OTHER
  isPrimary             Boolean @default(true)
  verified              Boolean @default(false)
  // Salary-payout designation (2026-10 round §42): isPrimary is a generic
  // "default account" flag and does NOT mean "salary payout account". Exactly
  // ONE account per employee may carry isSalaryPayoutAccount=true; the payout
  // resolver enforces uniqueness and falls back to the migrated single-account
  // case for legacy rows (backfill sets this flag on single-account employees).
  isSalaryPayoutAccount Boolean @default(false)

  @@index([vendorId, employeeId])
  @@index([vendorId, employeeId, isSalaryPayoutAccount])
}

model EmployeeDocument {
  id               String    @id @default(cuid())
  vendorId         String
  employeeId       String
  category         String    @default("IDENTITY") // IDENTITY | EDUCATION | EXPERIENCE | CONTRACT | OTHER
  docType          String // NID | PASSPORT | BIRTH_REG | DRIVING_LICENCE | OTHER_ID | CERTIFICATE | AGREEMENT | APPOINTMENT | CONFIRMATION | SUPPORTING
  title            String
  docNumber        String?
  nameOnDoc        String?
  issueDate        String?
  expiryDate       String?
  issuingAuthority String?
  status           String    @default("VALID") // VALID | EXPIRING | EXPIRED | REJECTED
  fileName         String?
  fileData         String? // base64
  notes            String?
  verified         Boolean   @default(false)
  verifiedBy       String?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([vendorId, employeeId])
  @@index([vendorId, expiryDate])
}

// ============================ EMPLOYEE LIFECYCLE (IMMUTABLE) ============================

model EmployeeHistory {
  id            String   @id @default(cuid())
  vendorId      String
  employeeId    String
  eventType     String // JOINED | PROMOTION | TRANSFER | SALARY_REVISION | STATUS_CHANGE | LEAVE | RESIGNATION | LETTER | WARNING | EXIT | TASK | REVIEW
  title         String
  description   String?
  dataJson      String   @default("{}")
  effectiveDate String?
  amount        Float?
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([vendorId, employeeId, createdAt])
}

model Promotion {
  id               String   @id @default(cuid())
  vendorId         String
  employeeId       String
  oldDesignationId String?
  newDesignationId String?
  oldDepartmentId  String?
  newDepartmentId  String?
  oldGrade         String?
  newGrade         String?
  newBasicSalary   Float?
  effectiveDate    String
  reason           String?
  status           String   @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedBy       String?
  createdAt        DateTime @default(now())

  @@index([vendorId, employeeId])
}

model Transfer {
  id                String   @id @default(cuid())
  vendorId          String
  employeeId        String
  fromBranchId      String?
  toBranchId        String?
  fromDepartmentId  String?
  toDepartmentId    String?
  fromDesignationId String?
  toDesignationId   String?
  fromManagerId     String?
  toManagerId       String?
  fromShiftId       String?
  toShiftId         String?
  workLocation      String?
  effectiveDate     String
  reason            String?
  status            String   @default("PENDING")
  approvedBy        String?
  createdAt         DateTime @default(now())

  @@index([vendorId, employeeId])
}

model SalaryRevision {
  id              String   @id @default(cuid())
  vendorId        String
  employeeId      String
  previousSalary  Float
  newSalary       Float
  increaseAmount  Float
  increasePercent Float
  effectiveDate   String
  reason          String?
  type            String   @default("INCREMENT") // INCREMENT | STRUCTURE_CHANGE | NEW_STRUCTURE
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedBy      String?
  createdAt       DateTime @default(now())

  @@index([vendorId, employeeId])
}

// ============================ ATTENDANCE ============================

model Attendance {
  id                String   @id @default(cuid())
  vendorId          String
  employeeId        String
  date              String // ISO date
  shiftId           String?
  checkIn           String? // HH:MM
  checkOut          String? // HH:MM
  workingMinutes    Int      @default(0)
  lateMinutes       Int      @default(0)
  earlyLeaveMinutes Int      @default(0)
  overtimeMinutes   Int      @default(0)
  status            String   @default("ABSENT") // PRESENT | ABSENT | LATE | EARLY_LEAVE | HALF_DAY | LEAVE | LEAVE_UNPAID | HOLIDAY | WEEKLY_OFF | WFH | BUSINESS_TRIP
  source            String   @default("MANUAL") // MANUAL | BIOMETRIC | GEOFENCE | SELFIE | WEB | IMPORT (QR retired)
  otApproved        Boolean? // null = auto-accepted (pre-approval-policy rows); false = pending approval; true = approved (spec §7.6)
  deviceInfo        String?
  latitude          Float?
  longitude         Float?
  accuracyM         Float?
  ip                String?
  remarks           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([vendorId, employeeId, date])
  @@index([vendorId, date])
}

model AttendanceDevice {
  id                    String    @id @default(cuid())
  vendorId              String
  deviceId              String // display code (operator-facing)
  name                  String
  branchId              String?
  manufacturer          String?
  model                 String?
  location              String?
  status                String    @default("ONLINE") // ONLINE | OFFLINE | ERROR (derived from lastSeenAt at read time)
  syncStatus            String    @default("IDLE") // IDLE | SYNCING | ERROR
  lastSyncAt            DateTime?
  lastError             String?
  // ---- ZKTeco ADMS push integration (additive — spec §7) ----
  serialNumber          String? // full device serial (informational)
  deviceIdentifier      String?   @unique // ADMS SN the device pushes — globally unique (endpoint has no tenant context)
  protocol              String    @default("ADMS") // ADMS | LEGACY_SDK
  enabled               Boolean   @default(true) // soft delete/deactivation — history is preserved
  ipAddress             String?
  port                  Int?
  timezone              String    @default("Asia/Dhaka")
  firmwareVersion       String?
  pushVersion           String?
  commKey               String? // M-20 — comm key ENCRYPTED at rest (enc::<iv.tag.enc>, AES-256-GCM under HRM_MFA_KEY, context devices::v1); shown ONCE at enrollment; legacy plaintext rows readable until rotated by scripts/encrypt-secrets-at-rest.ts; stripped from every API response
  commKeyHash           String? // write-only device credential (scrypt salted hash, v2; legacy sha256 hex supported read-only) — never returned to the UI
  commKeySalt           String? // H-2 — per-device scrypt salt (v2 key storage)
  commKeySetAt          DateTime? // C-03 — when the comm key was enrolled (enrollment audit metadata)
  lastSeenAt            DateTime?
  lastAttendanceAt      DateTime?
  clockDriftSec         Int? // device clock vs server clock (from live punches)
  eventCount            Int       @default(0) // total accepted raw events
  configuration         String    @default("{}") // adapter-specific tunables (JSON)
  // R8 — historical backfill sync: while historySyncUntil is in the future the
  // cdata ingest window for THIS device is widened to historySyncWindowDays so
  // old punches re-uploaded by the device are accepted instead of rejected as
  // OUT_OF_WINDOW. Set by devices.syncHistory; expires automatically.
  historySyncUntil      DateTime?
  historySyncWindowDays Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@unique([vendorId, deviceId])
  @@index([vendorId, enabled])
}

// Employee ↔ device enrollment mapping (spec §8) — stable device PIN, never names
model AttendanceDeviceUser {
  id               String    @id @default(cuid())
  vendorId         String
  deviceId         String
  employeeId       String
  deviceUserId     String // ZKTeco PIN on that specific device
  enrollmentStatus String    @default("ACTIVE") // ACTIVE | INACTIVE (offboarding/transfer)
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([deviceId, deviceUserId])
  @@index([vendorId, employeeId])
}

// Immutable raw attendance events (spec §9) — retained for audit/reprocessing
model AttendanceRawEvent {
  id                String    @id @default(cuid())
  vendorId          String
  deviceId          String
  deviceSerial      String
  deviceUserId      String
  employeeId        String? // resolved via AttendanceDeviceUser (null until mapped)
  eventTime         String // "YYYY-MM-DD HH:MM:SS" — device wall clock (Asia/Dhaka), never modified
  receivedAt        DateTime  @default(now())
  verifyMode        Int? // 1 fingerprint, 3/15 face, 4 card …
  attendanceStatus  Int? // raw device status code (0..5, 255 auto)
  workCode          String?
  eventType         String // IN | OUT | BREAK_OUT | BREAK_IN | OT_IN | OT_OUT | AUTO
  rawLine           String // original ADMS line, immutable
  payloadHash       String    @unique // deterministic fingerprint → idempotent ingestion (spec §10)
  processingStatus  String    @default("RECEIVED") // RECEIVED | PROCESSING | PROCESSED | UNKNOWN_EMPLOYEE | FAILED | SKIPPED_MANUAL | DEAD_LETTER | OUT_OF_WINDOW (quarantined old punch — reprocessed on historical sync)
  processingError   String?
  processedAt       DateTime?
  retryCount        Int       @default(0)
  // M-07 — atomic claim + honest backoff: claimedAt marks the PROCESSING
  // claim (stale claims self-heal), lastAttemptAt is when the LAST processing
  // attempt happened (retry backoff is measured from this, not createdAt).
  claimedAt         DateTime?
  lastAttemptAt     DateTime?
  // 2026-10 round §33 — provenance link to the normalized AttendanceEvent this
  // raw punch was projected into (inspectable device-punch → event chain).
  attendanceEventId String?
  createdAt         DateTime  @default(now())

  @@index([vendorId, deviceId, eventTime])
  @@index([vendorId, employeeId, eventTime])
  @@index([vendorId, processingStatus])
  // SCL-3 (Phase 1, index half) — the global sweeper query filters on
  // processingStatus ALONE (sweepOnce runs without a vendorId) with
  // orderBy eventTime; the (vendorId, processingStatus) index above has
  // vendorId as its leading column and cannot serve it, so every 15 s sweep
  // was a full-table scan over the raw-event table. This index serves
  // recoverStaleClaims' PROCESSING scan and the dead-letter/OUT_OF_WINDOW
  // updateMany filters.
  @@index([processingStatus, eventTime])
  // SCL-3 full (Phase 2 WS2) — the fair per-vendor sweep pages by
  // (vendorId, processingStatus IN (...)) ORDER BY eventTime LIMIT slice.
  // With only the two indexes above, a vendor with a 20K-event backfill paid
  // a sort of its whole pending set every 15 s pass; this composite serves
  // the per-vendor page as a clean index-ordered LIMIT scan.
  @@index([vendorId, processingStatus, eventTime])
}

// Device communication log (spec §16) — no secrets/biometric data, only metadata
model DeviceCommLog {
  id             String   @id @default(cuid())
  vendorId       String
  deviceId       String?
  serial         String
  endpoint       String
  requestType    String // HANDSHAKE | ATTLOG | OPERLOG | GETREQUEST | DEVICECMD | REJECTED
  httpStatus     Int
  eventCount     Int      @default(0)
  duplicateCount Int      @default(0)
  ok             Boolean  @default(true)
  durationMs     Int      @default(0)
  error          String?
  correlationId  String?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([vendorId, deviceId, createdAt])
  @@index([vendorId, createdAt])
}

// Queued device commands (ADMS getrequest channel) — CHECK etc.
model DeviceCommand {
  id        String    @id @default(cuid())
  vendorId  String
  deviceId  String
  command   String // CHECK | REBOOT | CLEAR LOG | … (adapter-limited whitelist)
  status    String    @default("QUEUED") // QUEUED | SENT | DONE | FAILED
  result    String?
  createdBy String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  doneAt    DateTime?

  @@index([vendorId, deviceId, status])
}

model AttendanceCorrection {
  id           String    @id @default(cuid())
  vendorId     String
  employeeId   String
  date         String
  requestedIn  String?
  requestedOut String?
  reason       String
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  actedBy      String?
  actedAt      DateTime?
  createdAt    DateTime  @default(now())

  @@index([vendorId, status])
}

// ============================ WORKFORCE TRACKING & SECURE ATTENDANCE (2026-10 round) ============================
// Architecture rules (requirements round §2–§5):
//   Attendance          → payroll-facing DAILY summary (unchanged, one row/employee/date)
//   AttendanceRawEvent  → immutable ZKTeco ADMS input (unchanged)
//   AttendanceEvent     → NEW immutable normalized event layer (append-only; check-in,
//                         check-out, periodic checks, device punches, GPS-state events)
//   TrackingPoint       → NEW append-only location telemetry history
//   EmployeeTrackingState → NEW current-state row per tracked employee (live dashboard reads
//                         THIS, never the history table)
//   GeoFence            → NEW reusable fence entity; Branch geofence fields remain as
//                         backward-compatible defaults and are backfilled into GeoFence rows
//   AttendancePolicy(+Assignment) → NEW dynamic policy engine, scope priority
//                         EMPLOYEE > DEPARTMENT > BRANCH > ALL_EMPLOYEES, effective policy
//                         always resolved server-side
//   AttendanceProof     → NEW secure selfie evidence (private storage route, audited access)

// ---------- Geo-Fence (requirements §19–§21) ----------
model GeoFence {
  id                 String                     @id @default(cuid())
  vendorId           String
  name               String
  branchId           String? // optional anchor branch (informational + assignment convenience)
  type               String                     @default("CIRCLE") // CIRCLE (geometryJson designed so POLYGON can be added later)
  latitude           Float
  longitude          Float
  radiusM            Float                      @default(150)
  geometryJson       String                     @default("{}") // future polygon geometries; CIRCLE uses lat/lng/radiusM
  startTime          String? // HH:MM fence-local validity window (null = all day)
  endTime            String?
  active             Boolean                    @default(true)
  // provenance flag for fences auto-created from legacy Branch geofence fields
  migratedFromBranch Boolean                    @default(false)
  policies           AttendancePolicyGeoFence[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([vendorId, active])
  @@index([vendorId, branchId])
}

// ---------- Dynamic attendance/tracking policy engine (§6–§7, §18, §29) ----------
model AttendancePolicy {
  id          String                       @id @default(cuid())
  vendorId    String
  name        String
  // TRACKING (live location + update interval + battery/GPS monitoring)
  // MANDATORY_GPS (GPS must stay on inside schedule; violations recorded)
  // MULTIPLE_CHECKIN (periodic re-verification check-ins)
  // ATTENDANCE_METHOD (which check-in methods are allowed: GEOFENCE / SELFIE / GEOFENCE_SELFIE / DEVICE_PUNCH)
  policyType  String
  priority    Int                          @default(0) // deterministic tie-break inside one scope level (higher wins)
  // schedule (server-clock authoritative — never the employee device clock)
  startDate   String? // ISO date the policy becomes valid (null = immediately)
  endDate     String? // ISO date the policy expires (null = no end)
  startTime   String? // HH:MM daily window start (null = all day)
  endTime     String?
  daysOfWeek  String                       @default("SUNDAY,MONDAY,TUESDAY,WEDNESDAY,THURSDAY") // comma list (Asia/Dhaka weekdays)
  timezone    String                       @default("Asia/Dhaka")
  active      Boolean                      @default(true)
  // typed per-policy-type configuration. Keys are validated server-side
  // (trackingPolicyConfig / multipleCheckinConfig zod schemas in validation.ts):
  //   TRACKING:        { updateIntervalSec, maxAccuracyM, lowBatteryThreshold, criticalBatteryThreshold, offlineAfterMinutes, suspiciousAction }
  //   MANDATORY_GPS:   { graceMinutes }
  //   MULTIPLE_CHECKIN:{ minIntervalMinutes, maxPerDay, methods[] }
  //   ATTENDANCE_METHOD:{ methods[], selfieRequired, requireGeofence }
  configJson  String                       @default("{}")
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  assignments AttendancePolicyAssignment[]
  fences      AttendancePolicyGeoFence[]

  @@index([vendorId, policyType, active])
}

// Scope-based assignment. Effective policy resolution order (§6):
// EMPLOYEE > DEPARTMENT > BRANCH > ALL_EMPLOYEES, computed server-side.
model AttendancePolicyAssignment {
  id        String           @id @default(cuid())
  vendorId  String
  policyId  String
  scopeType String // ALL_EMPLOYEES | BRANCH | DEPARTMENT | EMPLOYEE
  scopeId   String? // branch/department/employee id (null for ALL_EMPLOYEES)
  createdBy String?
  createdAt DateTime         @default(now())
  policy    AttendancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([vendorId, scopeType, scopeId])
  @@index([vendorId, policyId])
}

// Policy ↔ GeoFence many-to-many (§21): a policy can be valid for multiple
// fences (e.g. Head Office + Client Site A); the server decides which fences
// are currently in effect for an employee.
model AttendancePolicyGeoFence {
  id         String           @id @default(cuid())
  vendorId   String
  policyId   String
  geoFenceId String
  createdAt  DateTime         @default(now())
  policy     AttendancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  geoFence   GeoFence         @relation(fields: [geoFenceId], references: [id], onDelete: Cascade)

  @@unique([policyId, geoFenceId])
  @@index([vendorId, geoFenceId])
}

// ---------- Immutable normalized attendance events (§4–§5) ----------
model AttendanceEvent {
  id                      String    @id @default(cuid())
  vendorId                String
  employeeId              String
  eventType               String // CHECK_IN | CHECK_OUT | PERIODIC_CHECK_IN | PERIODIC_CHECK_OUT | PERIODIC_VERIFICATION | DEVICE_PUNCH | GPS_DISABLED | MANDATORY_GPS_VIOLATION | LOW_BATTERY | GEOFENCE_VIOLATION | SECURITY_FLAG
  attendanceMethod        String // BIOMETRIC | GEOFENCE | SELFIE | GEOFENCE_SELFIE | DEVICE_PUNCH | MOBILE | ADMIN | WEB
  source                  String    @default("WEB") // WEB | MOBILE | ZKTECO | ADMIN | SYSTEM
  occurredAt              DateTime // server-determined event time (authoritative)
  receivedAt              DateTime  @default(now())
  clientTimestamp         String? // device wall clock at capture — forensic comparison only, never trusted
  latitude                Float?
  longitude               Float?
  accuracyM               Float?
  altitude                Float?
  speed                   Float?
  heading                 Float?
  batteryPercentage       Int?
  isCharging              Boolean?
  gpsStatus               String? // OK | DISABLED | LOW_ACCURACY
  networkStatus           String? // ONLINE | OFFLINE | WEAK
  geoFenceId              String?
  distanceFromGeoFenceM   Float?
  locationIntegrityStatus String? // VERIFIED | SUSPICIOUS | MOCK_LOCATION | IMPOSSIBLE_MOVEMENT | STALE_LOCATION | LOW_ACCURACY | TIMESTAMP_ANOMALY | DEVICE_MISMATCH
  deviceId                String? // mobile device identifier (binding: session vs registered device)
  mobileSessionId         String?
  selfieProofId           String?
  attendanceId            String? // link to the daily Attendance summary row when the event drove check-in/out
  policyId                String?
  status                  String    @default("ACCEPTED") // VERIFIED | ACCEPTED | SUSPICIOUS | REVIEW_REQUIRED | REJECTED
  reviewStatus            String    @default("NONE") // NONE | PENDING | APPROVED | REJECTED (admin review workflow for suspicious events)
  reviewedBy              String?
  reviewedAt              DateTime?
  reason                  String?
  flagsJson               String    @default("{}") // integrity signals, notes, decision inputs
  clientEventId           String? // idempotency key supplied by the mobile client (§65)
  rawEventId              String? // provenance: AttendanceRawEvent this was normalized from (§33)
  createdAt               DateTime  @default(now())

  @@unique([vendorId, clientEventId])
  @@index([vendorId, employeeId, occurredAt])
  @@index([vendorId, occurredAt])
  @@index([vendorId, employeeId, eventType])
  @@index([vendorId, status, reviewStatus])
  @@index([vendorId, locationIntegrityStatus])
}

// ---------- Secure selfie proof (§26–§27) ----------
// Private evidence storage: bytes live in `data` (base64) behind a dedicated
// permission-gated view route — NEVER /public, never in list payloads, every
// view/download is audit-logged. retentionUntil drives the retention sweeper.
model AttendanceProof {
  id                 String    @id @default(cuid())
  vendorId           String
  employeeId         String
  attendanceEventId  String?
  proofType          String    @default("SELFIE")
  storageKey         String // logical key: proof/{vendorId}/{employeeId}/{id}
  mimeType           String    @default("image/jpeg")
  fileHash           String // sha-256 of the decoded bytes (tamper evidence)
  byteSize           Int       @default(0)
  data               String // base64 payload (private; only exposed via attendance.selfie.view)
  capturedAt         DateTime
  uploadedAt         DateTime  @default(now())
  latitude           Float?
  longitude          Float?
  accuracyM          Float?
  deviceId           String?
  verificationStatus String    @default("EVIDENCE") // EVIDENCE (proof only — NOT identity verification, §27)
  // Selfie Attendance G1 — capture provenance from the in-app camera
  // ({score, method, faceDetected, faceRatio, brightness, sharpness, width,
  //  height, bytesApprox}). EVIDENCE METADATA ONLY: it is shown to reviewers as
  // context and NEVER flips verificationStatus (§27 — a selfie is proof of
  // presence, not an identity check).
  qualityJson        String    @default("{}")
  retentionUntil     DateTime?
  createdAt          DateTime  @default(now())

  @@index([vendorId, employeeId, capturedAt])
  @@index([vendorId, retentionUntil])
}

// ---------- Selfie-/tracking capture consent (§27–§28, Privacy & Consent) ----------
// Audit round follow-up: the product had retention, private storage and a
// strict-audited view path for selfie evidence, plus the M-16 tracking consent
// gate, but NO explicit record of the employee ACKNOWLEDGING what a selfie
// punch means. Rysenova advertises "Data Privacy & Consent Controls", and a
// defensible consent record needs: the exact policy TEXT the employee agreed
// to (hashed, so a later policy edit cannot retro-fit consent), the version,
// when, from where and through which channel.
//
// Rules (deliberate, see SELFIE-ATTENDANCE-PLAN.md):
//   - consent NEVER blocks attendance. A missing consent is surfaced to HR for
//     follow-up; the punch still lands (an employee is never unpaid because a
//     checkbox was missed).
//   - consent rows are evidence of agreement, NOT telemetry: they are exempt
//     from sweepProofRetention() so they outlive the selfie bytes they justify.
//   - re-consent is a NEW row (a new version/text), never an overwrite — the
//     prior agreement stays provable.
model EmployeeConsent {
  id         String    @id @default(cuid())
  vendorId   String
  employeeId String
  purpose    String    @default("SELFIE_ATTENDANCE") // SELFIE_ATTENDANCE | TRACKING | BIOMETRIC
  version    String // policy version the employee accepted (e.g. "2026-10-03.1")
  textHash   String // sha-256 of the exact consent text shown (tamper evidence)
  acceptedAt DateTime  @default(now())
  source     String    @default("ESS_PORTAL") // ESS_PORTAL | ADMIN_IMPORT | PAPER_SCAN
  ip         String?
  userAgent  String?
  revokedAt  DateTime?
  revokedBy  String?
  createdAt  DateTime  @default(now())

  @@unique([vendorId, employeeId, purpose, version])
  @@index([vendorId, employeeId, purpose])
  @@index([vendorId, acceptedAt])
}

// ---------- Device binding (G2 — employee ↔ device enrollment) ----------
// A mobile punch carries deviceId; the engine already raises the
// DEVICE_MISMATCH location-integrity signal when the id changes during a day,
// but there was no ENROLLMENT concept: no "register this phone", no device cap,
// no admin revoke, and no way to make the binding actually block a punch.
//
// This model is that registry. Enforcement is policy-driven
// (AttendanceMethod ATTENDANCE_METHOD config `deviceBinding`):
//   OFF      — deviceId is recorded only (historical behaviour)
//   ADVISORY — an unregistered/foreign device still punches, but the event is
//              flagged DEVICE_MISMATCH for review (the existing lever)
//   STRICT   — only an ACTIVE enrolled device may punch; anything else is 403
//
// `keyHash` is a server-issued enrolment secret (never the raw device id):
// the device proves possession on later punches, so a cloned deviceId alone
// cannot impersonate the enrolled phone.
model EmployeeDevice {
  id           String    @id @default(cuid())
  vendorId     String
  employeeId   String
  deviceId     String // client-reported stable device identifier
  label        String? // human label ("Pixel 7 — Rakib's phone")
  platform     String? // ANDROID | IOS | WEB | UNKNOWN
  userAgent    String?
  keyHash      String? // sha-256 of the server-issued enrolment key (write-only)
  status       String    @default("ACTIVE") // PENDING | ACTIVE | REVOKED
  enrolledAt   DateTime  @default(now())
  enrolledIp   String?
  approvedBy   String? // admin user id for PENDING → ACTIVE
  approvedAt   DateTime?
  lastSeenAt   DateTime?
  lastSeenIp   String?
  revokedAt    DateTime?
  revokedBy    String?
  revokeReason String?
  createdAt    DateTime  @default(now())

  @@unique([vendorId, employeeId, deviceId])
  @@index([vendorId, employeeId, status])
  @@index([vendorId, deviceId])
}


// ---------- Location telemetry history (§10) ----------
model TrackingPoint {
  id                      String   @id @default(cuid())
  vendorId                String
  employeeId              String
  deviceId                String?
  timestamp               DateTime // server-received time (authoritative)
  clientTimestamp         String? // device clock — forensic only
  latitude                Float
  longitude               Float
  accuracyM               Float?
  altitude                Float?
  speed                   Float?
  heading                 Float?
  batteryPercentage       Int?
  isCharging              Boolean?
  gpsStatus               String?
  networkStatus           String?
  trackingSessionId       String?
  locationIntegrityStatus String?
  clientEventId           String? // idempotency (§65)
  createdAt               DateTime @default(now())

  @@unique([vendorId, clientEventId])
  @@index([vendorId, employeeId, timestamp])
  @@index([vendorId, timestamp])
  @@index([deviceId, timestamp])
}

// ---------- Current tracking state (§9) — one row per tracked employee ----------
model EmployeeTrackingState {
  id                String    @id @default(cuid())
  vendorId          String
  employeeId        String    @unique
  deviceId          String?
  trackingEnabled   Boolean   @default(false) // admin toggle (tracking.start/stop)
  trackingStatus    String    @default("OFFLINE") // TRACKING | GPS_DISABLED | LOW_ACCURACY | LOW_BATTERY | OFFLINE | OFFLINE_AFTER_LOW_BATTERY | POWER_OFF_UNCONFIRMED | OUTSIDE_GEOFENCE | SUSPICIOUS | NETWORK_LOST
  lastSeenAt        DateTime?
  latitude          Float?
  longitude         Float?
  accuracyM         Float?
  batteryPercentage Int?
  isCharging        Boolean?
  gpsStatus         String?
  networkStatus     String?
  geoFenceId        String?
  insideGeoFence    Boolean?
  lastEventId       String?
  lastPolicyId      String?
  sessionStartedAt  DateTime?
  updatedAt         DateTime  @updatedAt

  @@index([vendorId, trackingStatus])
  @@index([vendorId, trackingEnabled])
}

// ============================ LEAVE ============================

model LeaveType {
  id                       String  @id @default(cuid())
  vendorId                 String
  code                     String
  name                     String
  paid                     Boolean @default(true)
  defaultDays              Int     @default(10)
  carryForward             Boolean @default(false)
  maxCarryForward          Int     @default(0)
  // HRM-011 — carry-forward & accrual depth (editable from Settings → Leave)
  carryForwardExpiryMonths Int     @default(3)
  accrualFrequency         String  @default("ANNUAL") // ANNUAL | MONTHLY | QUARTERLY | PRO_RATA
  encashmentAllowed        Boolean @default(false)
  // HRM-012 — encashment rules (rate × daily basic, capped)
  encashmentRate           Float   @default(1) // multiple of daily gross
  encashmentCap            Float   @default(0) // 0 = no cap (DAYS — LVE-006 unified both encashment paths)
  waitingPeriodDays        Int     @default(0)
  probationEligible        Boolean @default(false)
  requiresAttachment       Boolean @default(false)
  // LVE-107 — gender-restricted eligibility (maternity → FEMALE, paternity →
  // MALE under the Bangladesh Labour Act structure). null = no restriction.
  genderRestriction        String?
  // LVE-113 (R7) — consecutive-day cap (BD norms: casual leave is capped at a
  // few consecutive days at a time). 0 = no cap. Enforced on apply against
  // the request window EXTENDED by adjacent approved/pending leave of the
  // same type.
  maxConsecutiveDays       Int     @default(0)
  active                   Boolean @default(true)

  @@unique([vendorId, code])
}

model LeaveBalance {
  id             String @id @default(cuid())
  vendorId       String
  employeeId     String
  leaveTypeId    String
  year           Int
  entitled       Float  @default(0)
  used           Float  @default(0)
  pending        Float  @default(0)
  carriedForward Float  @default(0)

  @@unique([employeeId, leaveTypeId, year])
  @@index([vendorId, year])
}

model LeaveRequest {
  id                   String    @id @default(cuid())
  vendorId             String
  employeeId           String
  leaveTypeId          String
  fromDate             String
  toDate               String
  days                 Float
  reason               String?
  halfDay              Boolean   @default(false)
  attachmentName       String?
  attachmentData       String?
  substituteEmployeeId String?
  substituteStatus     String? // PENDING | ACCEPTED | DECLINED
  substituteComment    String?
  contactNumber        String? // reachable phone during leave (spec §8.1)
  status               String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED | WITHDRAWN
  approvalRequestId    String?
  actedBy              String?
  actedAt              DateTime?
  createdAt            DateTime  @default(now())
  // H-10 — leave history is Restrict: an employee with leave records cannot be
  // hard-deleted at the DB layer (the app archives instead).
  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([vendorId, id]) // H-10 — structural tenant scoping
  @@index([vendorId, status])
  @@index([vendorId, employeeId])
}

// ============================ COMPENSATION & PAYROLL ============================

model SalaryStructure {
  id                   String   @id @default(cuid())
  vendorId             String
  employeeId           String
  effectiveFrom        String
  effectiveTo          String? // null = current
  basic                Float    @default(0)
  houseRent            Float    @default(0)
  medical              Float    @default(0)
  conveyance           Float    @default(0)
  food                 Float    @default(0)
  mobileAllow          Float    @default(0)
  internetAllow        Float    @default(0)
  attendanceAllow      Float    @default(0)
  otherAllowance       Float    @default(0)
  gross                Float    @default(0)
  // H-09 step 1 — staged paisa migration: integer duplicates alongside the
  // Float columns (kept in sync by the engine + backfilled). Float columns are
  // dropped in a later release once all consumers are confirmed migrated.
  // 2026-10-13 — widened Int → BigInt: a payroll total in paisa crossed the
  // INT4 ceiling (2,147,483,647) once gross exceeded ~Tk 21.47M (e.g.
  // totalGrossPaisa = 5,003,650,000 threw "Unable to fit integer value into an
  // INT4"). All paisa shadow columns are now BIGINT (see migration 9_wave6).
  basicPaisa           BigInt? // = ROUND(basic * 100)
  houseRentPaisa       BigInt?
  medicalPaisa         BigInt?
  conveyancePaisa      BigInt?
  foodPaisa            BigInt?
  mobileAllowPaisa     BigInt?
  internetAllowPaisa   BigInt?
  attendanceAllowPaisa BigInt?
  otherAllowancePaisa  BigInt?
  grossPaisa           BigInt?
  componentsJson       String   @default("[]") // extra flexible components
  revisionId           String?
  status               String   @default("ACTIVE") // ACTIVE | SUPERSEDED | TERMINATED
  createdBy            String?
  createdAt            DateTime @default(now())

  @@index([vendorId, employeeId])
}

model PayrollRun {
  id                  String         @id @default(cuid())
  vendorId            String
  periodMonth         Int
  periodYear          Int
  periodWeek          Int            @default(0) // ISO week number for WEEKLY frequency (0 = monthly)
  frequency           String         @default("MONTHLY")
  runType             String         @default("REGULAR") // REGULAR | ADJUSTMENT
  adjustRunId         String? // original run this adjusts
  adjustSeq           Int            @default(0) // H-16 — sequence within (vendor, period, runType): 0 = the original run, 1..n = successive adjustment runs
  cutoffDate          String?
  processedDate       String?
  paymentDate         String?
  status              String         @default("DRAFT") // DRAFT | CALCULATED | HR_REVIEW | MANAGER_APPROVAL | ACCOUNTING_APPROVAL | APPROVED | PROCESSING | PAID | CANCELLED
  totalGross          Float          @default(0)
  totalOt             Float          @default(0)
  totalBonus          Float          @default(0)
  totalDeduction      Float          @default(0)
  totalAit            Float          @default(0)
  totalNet            Float          @default(0)
  // H-09 step 1 — paisa duplicates of the run totals (integer, backfilled)
  // 2026-10-13 — Int → BigInt (INT4 overflow on large payrolls, migration 9_wave6)
  totalGrossPaisa     BigInt?
  totalOtPaisa        BigInt?
  totalBonusPaisa     BigInt?
  totalDeductionPaisa BigInt?
  totalAitPaisa       BigInt?
  totalNetPaisa       BigInt?
  employeeCount       Int            @default(0)
  createdBy           String?
  approvalRequestId   String?
  journalId           String?
  // ---- WP-F (2026-10-08) — payout confirmation leg (additive) ----
  payoutConfirmedAt   DateTime? // salary disbursement confirmed → SALARY_PAYOUT journal
  payoutJournalId     String?
  cancelledAt         DateTime? // run cancelled after pay → PAYROLL_REVERSAL journal
  // ---- WP-G (2026-10-08) — preflight auto-exclusion (additive) ----
  excludedJson        String? // preflight BLOCKED employees excluded from generation [{id,code,name,reason}]
  // MON-7 (Phase 4) — calculation claim fencing: bumped conditionally at the
  // start of every calculateRun; the final rewrite only commits while the
  // epoch still matches, so concurrent recalcs / racing submissions can
  // never interleave writes.
  calcEpoch           Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  entries             PayrollEntry[]

  @@unique([vendorId, periodYear, periodMonth, periodWeek, runType, adjustSeq])
  @@unique([vendorId, id]) // H-10 — structural tenant scoping // H-16 — adjustSeq=0 keeps the old single-regular-run guarantee
  @@index([vendorId, status])
}

model PayrollEntry {
  id                    String     @id @default(cuid())
  vendorId              String
  runId                 String
  employeeId            String
  structureId           String?
  presentDays           Float      @default(0)
  absentDays            Float      @default(0)
  lateMinutes           Int        @default(0)
  otMinutes             Int        @default(0)
  leaveDays             Float      @default(0)
  gross                 Float      @default(0)
  otAmount              Float      @default(0)
  bonus                 Float      @default(0)
  commission            Float      @default(0)
  absenceDeduction      Float      @default(0)
  lateDeduction         Float      @default(0)
  loanDeduction         Float      @default(0)
  advanceDeduction      Float      @default(0)
  otherDeduction        Float      @default(0)
  // 2026-10-14 — loan/advance installments recovered from THIS employee's
  // salary as a GUARANTOR of an absent borrower (guarantor fallback, Payroll
  // → Loan & Advance Control). Kept separate from loanDeduction (the
  // guarantor's own loans) so payRun recovers the right borrower ledgers and
  // payslips can itemise "Guarantor recovery — <borrower>" lines. The
  // borrower-side detail (loanId/advanceId/installmentId/amount) rides in
  // breakdownJson.guarantorRecoveries.
  guarantorDeduction    Float      @default(0)
  ait                   Float      @default(0)
  net                   Float      @default(0)
  // H-09 step 1 — paisa duplicates of every entry money field (integer,
  // dual-written by calculateRun; backfilled for historical rows)
  // 2026-10-13 — Int → BigInt (INT4 overflow guard, migration 9_wave6)
  grossPaisa            BigInt?
  otAmountPaisa         BigInt?
  bonusPaisa            BigInt?
  commissionPaisa       BigInt?
  absenceDeductionPaisa BigInt?
  lateDeductionPaisa    BigInt?
  loanDeductionPaisa    BigInt?
  advanceDeductionPaisa BigInt?
  otherDeductionPaisa   BigInt?
  guarantorDeductionPaisa BigInt?
  aitPaisa              BigInt?
  netPaisa              BigInt?
  breakdownJson         String     @default("{}") // full component snapshot
  taxRuleSetId          String?
  payslipNumber         String?
  emailStatus           String? // payslip email delivery outcome (SENT/FAILED/SKIPPED)
  // R1 (2026-10-12) — payroll cancel/recreate support: exact record of the
  // loan/advance recoveries applied by payRun for THIS entry, written at pay
  // time and consumed by payroll.runs.cancel to revert ledgers precisely
  // (no double-recovery when the month is re-paid). null = never paid.
  recoveryJson          String?
  // H-10 — money/history: employee relation Restrict
  employee              Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  status                String     @default("INCLUDED") // INCLUDED | EXCLUDED | ADJUSTED
  adjustEntryId         String? // entry adjusted by adjustment run
  journalId             String?
  // H-10 — CHANGED from Cascade to Restrict (dedicated migration with change
  // note): deleting a PayrollRun with entries is blocked; money history must
  // never silently cascade away. Runs are cancelled/adjusted, not deleted.
  run                   PayrollRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([runId, employeeId])
  @@unique([vendorId, id]) // H-10 — structural tenant scoping
  @@index([vendorId, employeeId])

  // M-13 — payslip numbers are unique per vendor. Same-period adjustment runs
  // carry an -A<seq> discriminator in the number itself; the migration
  // renumbers historical duplicates (-Rn suffix) before creating the index.
  @@unique([vendorId, payslipNumber])
}

model TaxRuleSet {
